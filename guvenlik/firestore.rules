rules_version = '2';

// =============================================================================
//  İnciroğlu Otomotiv · Cloud Firestore Güvenlik Kuralları
//  Sürüm 2026-10-10 · TÜM uygulamalar ortak girişte; tüm koleksiyonlar rol bazlı kilitli
// -----------------------------------------------------------------------------
//  İLKE: VARSAYILAN RED. Aşağıda açıkça izin verilmeyen her okuma/yazma reddedilir.
//  Kimlik  : Firebase Authentication (request.auth).
//  Yetki   : hesaplar/{hid} (roller + kapsam; YALNIZ İK yazar)
//            uidBag/{uid}   (Firebase oturumu ↔ hesap bağı; kişi yalnız geçerli
//                            aktivasyon koduyla KENDİ bağını kurar)
//  hid     : SHA-256("inciroglu-hesap|" + TC Kimlik No) — belge adlarında TC yoktur.
//  Herkese açık yalnız dört uç vardır: iş başvurusu OLUŞTURMA ve portal erişim talebi
//  OLUŞTURMA (ikisi de sıkı alan denetimiyle, okuma yok) ve tahmin edilemez anahtarla
//  tek bir sınav kaydı (aday sınavı) ile tek bir ayrılış anketi kaydı (12.11.2026).
//  Ayrıntılı açıklama ve değişiklik süreci: guvenlik/README.md
//  Yayın   : Firebase Konsolu → Firestore Database → Kurallar (Rules) → Yayınla.
// =============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------ yardımcılar
    function oturum() { return request.auth != null; }
    function yol(koleksiyon, kimlik) { return /databases/$(database)/documents/$(koleksiyon)/$(kimlik); }
    function bagli() { return oturum() && exists(yol('uidBag', request.auth.uid)); }
    function benimHid() { return get(yol('uidBag', request.auth.uid)).data.hid; }
    function hesap() { return get(yol('hesaplar', benimHid())).data; }
    // Geçerli hesap: oturum bir hesaba bağlı, hesap AKTİF ve hesabın GÜNCEL oturumu bu.
    // (İK yeni kod üretince ya da hesabı kapatınca eski oturumlar anında yetkisiz kalır.)
    function gecerli() { return bagli() && hesap().aktif == true && hesap().uid == request.auth.uid; }
    function rolden(roller) { return gecerli() && hesap().roller.hasAny(roller); }
    function rol(r) { return rolden([r]); }
    function ik() { return rol('ik'); }
    function yonetimRolleri() { return ['ik', 'direktor', 'satis_mudur', 'servis_mudur', 'idari_mudur', 'mudur']; }
    function yonetim() { return rolden(yonetimRolleri()); }
    function kapsam() { return hesap().kapsam; }
    function tcOzeti(tc) { return hashing.sha256('inciroglu-hesap|' + tc).toHexString().lower(); }
    // Metin alanı: tür + uzunluk sınırı + HTML etiketi yok (herkese açık formlardan betik enjeksiyonuna karşı)
    function metin(v, enFazla) { return v is string && v.size() <= enFazla && !v.matches('(?s).*[<>].*'); }

    // ====================================================== HESAP ALTYAPISI
    function hesapAlanlari() {
      return ['ad', 'tc', 'roller', 'kapsam', 'aktif', 'uid', 'kodHash', 'kodSon', 'kodDurum',
              'olusturan', 'olusturma', 'guncelleyen', 'guncelleme', 'aktivasyon'];
    }
    function rollerGecerli(r) {
      return r is list && r.size() >= 1 && r.size() <= 8
        && r.hasOnly(['calisan', 'ik', 'direktor', 'satis_mudur', 'servis_mudur', 'idari_mudur', 'mudur']);
    }
    function hesapVerisiGecerli(h, y) {
      return y.keys().hasOnly(hesapAlanlari())
        && metin(y.ad, 120) && y.ad.size() > 0
        && y.tc is string && y.tc.matches('[1-9][0-9]{10}')
        && tcOzeti(y.tc) == h
        && rollerGecerli(y.roller)
        && y.kapsam is map
        && y.aktif is bool;
    }
    // Kullanılmış bir aktivasyon kodu, eski bir kayıt üzerine yazılarak yeniden canlandırılamaz.
    function kodCanlanmiyor() {
      return resource == null
        || !(resource.data.kodDurum == 'kullanildi'
             && request.resource.data.kodDurum == 'bekliyor'
             && request.resource.data.kodHash == resource.data.kodHash);
    }
    // İK: hesap açar, rol/kapsam verir, aktivasyon kodu (yalnız özeti) üretir, hesabı kapatır.
    function ikHesapYazimi(h) { return ik() && hesapVerisiGecerli(h, request.resource.data) && kodCanlanmiyor(); }

    // Aktivasyon: kişi, İK'nın verdiği süreli kodla KENDİ hesabını yeni oturumuna bağlar.
    // Aynı toplu yazmada uidBag/{uid} de oluşturulur; kod özeti orada da aynı olmalıdır.
    function aktivasyon(h) {
      let once = resource.data;
      let sonra = request.resource.data;
      let bag = getAfter(yol('uidBag', request.auth.uid)).data;
      return oturum()
        && once.aktif == true
        && once.kodDurum == 'bekliyor'
        && once.kodSon is timestamp && once.kodSon > request.time
        && bag.hid == h
        && bag.kodHash == once.kodHash
        && sonra.diff(once).affectedKeys().hasOnly(['uid', 'kodDurum', 'aktivasyon'])
        && sonra.uid == request.auth.uid
        && sonra.kodDurum == 'kullanildi'
        && sonra.aktivasyon == request.time;
    }

    // TEK SEFERLİK KURULUM — ilk İK yöneticisinin hesabı. Kod kurala yalnız SHA-256 özeti olarak yazılıdır
    // (100 bit rastgele; tersine çevrilemez). kurulum/tek belgesi yalnız BİR KEZ oluşturulabildiği için kod
    // ikinci kez kullanılamaz; 24.10.2026'da da kendiliğinden kapanır. Kurulum bitince bu bölüm silinecektir.
    function kurulumKodu(kod) {
      return request.time < timestamp.date(2026, 10, 24)
        && kod is string && kod.size() == 20
        && hashing.sha256(kod).toHexString().lower() == 'ee77addb2ef20d04700a469ae611dda091b16faaab1b87c9b11f685685333e20';
    }
    function kurulumVar() {
      return oturum()
        && !exists(yol('kurulum', 'tek'))
        && existsAfter(yol('kurulum', 'tek'))
        && getAfter(yol('kurulum', 'tek')).data.uid == request.auth.uid
        && kurulumKodu(getAfter(yol('kurulum', 'tek')).data.kod);
    }
    function kurulumHesabi(h) {
      let y = request.resource.data;
      return kurulumVar()
        && hesapVerisiGecerli(h, y)
        && y.roller == ['calisan', 'ik']
        && y.kapsam.size() == 0
        && y.aktif == true
        && y.uid == request.auth.uid
        && y.kodDurum == 'kullanildi'
        && getAfter(yol('uidBag', request.auth.uid)).data.hid == h;
    }

    // hesaplar/{hid}: kişi başına bir kayıt (ad, tc, roller, kapsam, aktiflik, kod özeti).
    match /hesaplar/{h} {
      allow get: if ik() || (gecerli() && benimHid() == h);
      allow list: if ik();
      allow create: if ikHesapYazimi(h) || kurulumHesabi(h);
      allow update: if ikHesapYazimi(h) || aktivasyon(h);
      allow delete: if ik();
    }

    // uidBag/{uid}: Firebase oturumu ↔ hesap bağı. Yalnız oturum sahibi, yalnız geçerli kodla kurar.
    function kodlaBag(b) {
      return exists(yol('hesaplar', b.hid))
        && get(yol('hesaplar', b.hid)).data.aktif == true
        && get(yol('hesaplar', b.hid)).data.kodDurum == 'bekliyor'
        && get(yol('hesaplar', b.hid)).data.kodHash == b.kodHash
        && get(yol('hesaplar', b.hid)).data.kodSon is timestamp
        && get(yol('hesaplar', b.hid)).data.kodSon > request.time;
    }
    match /uidBag/{u} {
      allow get: if (oturum() && request.auth.uid == u) || ik();
      allow list: if ik();
      allow create: if oturum() && request.auth.uid == u
        && request.resource.data.keys().hasOnly(['hid', 'kodHash', 'ts'])
        && request.resource.data.hid is string
        && request.resource.data.kodHash is string
        && request.resource.data.ts == request.time
        && existsAfter(yol('hesaplar', request.resource.data.hid))
        && getAfter(yol('hesaplar', request.resource.data.hid)).data.uid == u
        && (kodlaBag(request.resource.data) || kurulumVar());
      allow update, delete: if ik();
    }

    // kurulum/tek: tek seferlik kurulum kaydı (yalnız süre içinde, doğru kodla, YALNIZ BİR KEZ oluşturulabilir).
    match /kurulum/{id} {
      allow create: if id == 'tek' && oturum()
        && request.resource.data.keys().hasOnly(['kod', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && kurulumKodu(request.resource.data.kod);
      allow get, list: if ik();
    }

    // girisAdresi/{hid}: TC ile girişte kişinin Firebase hesabını bulmak için. Yalnız TEK belge
    // okunabilir (listeleme yok); içinde kişisel veri yoktur (sisteme özel e-posta adresi).
    match /girisAdresi/{h} {
      allow get: if true;
      allow list: if false;
      allow create, update: if oturum()
        && request.resource.data.keys().hasOnly(['e'])
        && request.resource.data.e == request.auth.token.email
        && getAfter(yol('uidBag', request.auth.uid)).data.hid == h
        && getAfter(yol('hesaplar', h)).data.uid == request.auth.uid;
      allow delete: if ik();
    }

    // ============================================== İK + SATIŞ (satisVeri)
    // satisVeri koleksiyonu tarihsel nedenle hem satış panosunun canlı verisini ('current') hem İK
    // belgelerini (özlük, izin, harcama, puantaj, giriş-çıkış, ...) barındırır; kurallar BELGE bazında ayrıştırır.
    match /satisVeri/{belge} {
      // Satış panosu: İK (yönetici), direktör (görüntüleyici), satış müdürü okur.
      allow get: if belge == 'current' && rolden(['ik', 'direktor', 'satis_mudur']);
      // Satış müdürü yalnız elle girilen alanları değiştirebilir (eski çalışan, manuel danışman/fiili).
      allow update: if belge == 'current' && rol('satis_mudur')
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['eskiCalisanlar', 'manuelDanismanlar', 'manuelFiili', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
      // Personel listesinin kişisel veri İÇERMEYEN özeti (ad, departman, bölüm, unvan, tarihler).
      allow get: if belge == 'mrPersonelOzet' && yonetim();
      // İK Analitik Panosu verisi.
      allow get: if belge == 'ikPano' && rolden(['ik', 'direktor', 'idari_mudur']);
      // Satış danışmanlarının giriş/çıkış tarihi ve ayrılış notu (kişisel veri): yalnız İK ve direktör.
      allow get: if belge == 'danismanDetay' && rolden(['ik', 'direktor']);
      // İK: tüm belgeler (satış verisi dahil; Excel köprüsü İK oturumunda çalışır).
      allow read, write: if ik();
    }
    // Satış karneleri ve hedef tebliğleri. (Marka bazlı ayrım arayüzde yapılır; bkz. README.)
    // Müdür yazımında kayıt kimliği belge kimliğiyle aynı ve yalnız harf/rakam, yıl/ay sayı olmalıdır.
    function satisKaydiGecerli(id) {
      let d = request.resource.data;
      return id.matches('[A-Za-z0-9_-]{1,64}') && d.id == id && d.yil is number && d.ay is number;
    }
    match /satisKarneler/{id} {
      allow read: if rolden(['ik', 'direktor', 'satis_mudur']);
      allow create, update: if ik() || (rol('satis_mudur') && satisKaydiGecerli(id));
      allow delete: if rolden(['ik', 'satis_mudur']);
    }
    match /satisTebligler/{id} {
      allow read: if rolden(['ik', 'direktor', 'satis_mudur']);
      allow create, update: if ik() || (rol('satis_mudur') && satisKaydiGecerli(id));
      allow delete: if rolden(['ik', 'satis_mudur']);
    }

    // ============================================================== SERVİS
    function servisMarkasi() { return kapsam().servisMarka; }
    match /servisVeri/{belge} {
      allow read: if rolden(['ik', 'direktor', 'servis_mudur']);
      // Servis müdürü yalnız kadroya (elle danışman ekleme) dokunabilir; metrik ve marka tanımları İK'da.
      allow update: if belge == 'current' && rol('servis_mudur')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kadro', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
      allow write: if ik();
    }
    match /servisTebligler/{id} {
      allow read: if ik() || rol('direktor') || (rol('servis_mudur') && resource.data.marka == servisMarkasi());
      allow create: if ik() || (rol('servis_mudur') && request.resource.data.marka == servisMarkasi());
      allow update: if ik() || (rol('servis_mudur') && resource.data.marka == servisMarkasi() && request.resource.data.marka == servisMarkasi());
      allow delete: if ik();
    }
    match /servisKarneler/{id} {
      allow read: if ik() || rol('direktor') || (rol('servis_mudur') && resource.data.marka == servisMarkasi());
      allow create: if ik() || (rol('servis_mudur') && request.resource.data.marka == servisMarkasi());
      allow update: if ik() || (rol('servis_mudur') && resource.data.marka == servisMarkasi() && request.resource.data.marka == servisMarkasi());
      allow delete: if ik();
    }

    // ====================================================== YETENEK HAVUZU
    match /employees/{id} {
      allow read: if yonetim();
      allow write: if ik();
    }
    // Arşiv işareti yalnız İK'nındır; değerlendirici onu ekleyemez ya da değiştiremez.
    function arsivDegismiyor() {
      return resource == null
        ? !('arsiv' in request.resource.data)
        : !request.resource.data.diff(resource.data).affectedKeys().hasAny(['arsiv']);
    }
    // Değerlendirme, giren kişinin oturumu ve hesabındaki adıyla imzalanır; zaman sunucu saatidir
    // (başkası adına ya da geçmiş tarihli kayıt bırakılamaz). Belge kimliği "dönem::personel" biçimindedir.
    function degerlendirmeImzali(id) {
      let d = request.resource.data;
      return d.submittedByUid == request.auth.uid
        && d.submittedByName == hesap().ad
        && d.updatedAt == request.time
        && id == d.donem + '::' + d.employeeId
        && arsivDegismiyor();
    }
    // TAMAMLANMIŞ bir değerlendirmeyi yalnız onu tamamlayan kişi (ya da İK) değiştirebilir; taslak devam ettirilebilir.
    function tamamlanmisDegil() {
      return resource.data.get('status', '') != 'tamamlandi'
        || resource.data.get('submittedByUid', '') == request.auth.uid;
    }
    match /evaluations/{id} {
      allow read: if yonetim();
      allow create: if ik() || (yonetim() && degerlendirmeImzali(id));
      allow update: if ik() || (yonetim() && degerlendirmeImzali(id) && tamamlanmisDegil());
      allow delete: if ik();
    }
    // Değerlendirici kapsam profilleri ve dönem ayarı
    match /managers/{id} {
      allow read: if yonetim();
      allow write: if ik();
    }

    // ============================================================= İŞE ALIM
    function isealimDep() { return kapsam().isealimDepartman; }
    // Herkese açık iş başvurusu (basvuru.html): yalnız OLUŞTURMA; alanlar, türler, uzunluklar ve başlangıç
    // durumu sıkı denetlenir; HTML etiketi kabul edilmez. Okuma/güncelleme/silme herkese KAPALI.
    // CV yalnız PDF / Word olabilir (HTML, SVG vb. çalıştırılabilir içerik reddedilir); en fazla ~600 KB.
    function cvTurleri() {
      return ['application/pdf', 'application/msword',
              'application/vnd.openxmlformats-officedocument.wordprocessingml.document'];
    }
    function cvGecerli(c) {
      return c is map && c.keys().hasOnly(['ad', 'tip', 'boyut', 'veri'])
        && metin(c.ad, 200) && c.tip in cvTurleri()
        && c.boyut is int && c.boyut > 0 && c.boyut <= 650000
        && c.veri is string && c.veri.size() <= 900000
        && c.veri.matches('data:' + c.tip + ';base64,[A-Za-z0-9+/=]+');
    }
    function basvuruGecerli() {
      let d = request.resource.data;
      let p = d.basvurulanPozisyonlar;
      let g = d.gecmis;
      return d.keys().hasOnly(['ad', 'soyad', 'telefon', 'email', 'yas', 'yer', 'unvan', 'basvurulanPozisyonlar',
                               'departman', 'deneyimYil', 'deneyim', 'notlar', 'durum', 'kaynak', 'basvuruTarihi',
                               'evraklar', 'degerlendirmeler', 'etiketler', 'gecmis', 'olusturmaTarihi',
                               'guncellemeTarihi', 'cv'])
        && metin(d.ad, 60) && d.ad.size() > 0 && metin(d.soyad, 60) && d.soyad.size() > 0
        && metin(d.telefon, 30) && metin(d.email, 120) && metin(d.yer, 80)
        && (d.yas == null || (d.yas is int && d.yas >= 14 && d.yas <= 90))
        && metin(d.unvan, 120) && metin(d.departman, 60) && metin(d.deneyimYil, 40)
        && metin(d.deneyim, 4000) && metin(d.notlar, 4000) && metin(d.basvuruTarihi, 10)
        && p is list && p.size() >= 1 && p.size() <= 3
        && metin(p[0], 120) && (p.size() < 2 || metin(p[1], 120)) && (p.size() < 3 || metin(p[2], 120))
        && d.durum == 'gorusme_bekliyor' && d.kaynak == 'Web Başvurusu'
        && d.evraklar == [] && d.degerlendirmeler == [] && d.etiketler == []
        && g is list && g.size() == 1 && g[0] is map
        && g[0].keys().hasOnly(['tarih', 'eskiDurum', 'yeniDurum', 'kullanici', 'not'])
        && metin(g[0].tarih, 10) && g[0].eskiDurum == null && g[0].yeniDurum == 'gorusme_bekliyor'
        && g[0].kullanici == 'Web Başvurusu' && metin(g[0].not, 300)
        && d.olusturmaTarihi == request.time && d.guncellemeTarihi == request.time
        && (!('cv' in d) || cvGecerli(d.cv));
    }
    // Yeni kayıt kimliği yalnız Firestore'un otomatik ürettiği biçimde olabilir (20 harf/rakam): kimliğe
    // HTML/kod gömülemez.
    function otomatikKimlik(id) { return id.matches('[A-Za-z0-9]{20}'); }
    match /iseAlimAday/{id} {
      allow read: if ik() || (yonetim() && resource.data.departman == isealimDep());
      allow create: if otomatikKimlik(id)
        && (ik() || (yonetim() && request.resource.data.departman == isealimDep()) || basvuruGecerli());
      allow update: if ik() || (yonetim() && resource.data.departman == isealimDep()
                                && request.resource.data.departman == isealimDep());
      allow delete: if ik();
    }
    match /personelTalepleri/{id} {
      allow read: if ik() || (yonetim() && resource.data.departman == isealimDep());
      allow create: if otomatikKimlik(id)
        && (ik() || (yonetim() && request.resource.data.departman == isealimDep()));
      allow update: if ik() || (yonetim() && resource.data.departman == isealimDep()
                                && request.resource.data.departman == isealimDep());
      allow delete: if ik();
    }
    // Portal erişim talebi (IK-PLATFORM/tanitim.html formu): herkes YALNIZ yeni kayıt oluşturur; okuma,
    // durum güncelleme ve silme yalnız İK (İşe Alım → Personel Talepleri → Portal Erişim Talepleri).
    // Talep hiçbir yetki vermez; hesap yine İK tarafından hesaplar/ altında açılır.
    function erisimTalebiGecerli() {
      let d = request.resource.data;
      return d.keys().hasOnly(['ad', 'eposta', 'marka', 'rol', 'not', 'onay', 'durum', 'kaynak', 'olusturma'])
        && d.keys().hasAll(['ad', 'eposta', 'marka', 'rol', 'not', 'onay', 'durum', 'kaynak', 'olusturma'])
        && d.onay == true
        && metin(d.ad, 80) && d.ad.size() >= 3
        && metin(d.eposta, 120) && d.eposta.matches('[^@ ]+@[^@ ]+[.][^@ ]+')
        && metin(d.marka, 60) && d.marka.size() > 0
        && metin(d.rol, 60) && d.rol.size() > 0
        && metin(d.not, 500)
        && d.durum == 'yeni' && d.kaynak == 'Tanıtım Sayfası'
        && d.olusturma == request.time;
    }
    match /erisimTalepleri/{id} {
      allow read, update, delete: if ik();
      allow create: if otomatikKimlik(id) && erisimTalebiGecerli();
    }
    // Aday sınavı: aday yalnız bağlantıdaki tahmin edilemez anahtarla (128 bit) TEK kaydı okur ve BİR KEZ
    // tamamlar; aday dosyasına ve İK notlarına erişemez. Tamamlanan sınavın sonuçları bağlantıyla OKUNAMAZ
    // (yalnız İK / ilgili departman). Listeleme yalnız İK / ilgili departman.
    function sinavPersoneli() {
      return ik() || (yonetim() && resource.data.adayDepartman == isealimDep());
    }
    function sinavAlanlari() {
      return ['adayId', 'adayDepartman', 'adayAd', 'pozisyon', 'pozisyonAd', 'durum', 'olusturma'];
    }
    function sinavTamamlama() {
      let once = resource.data;
      let sonra = request.resource.data;
      return once.durum == 'bekliyor'
        && sonra.durum == 'tamamlandi'
        && sonra.diff(once).affectedKeys().hasOnly(['durum', 'tamamlanmaTarihi', 'boyutlar', 'uygunluk', 'gecerlik', 'cevaplar', 'tamamlanma'])
        && sonra.tamamlanma == request.time
        && metin(sonra.tamamlanmaTarihi, 10)
        && sonra.boyutlar is map && sonra.gecerlik is map && sonra.cevaplar is map
        && (sonra.uygunluk == null || sonra.uygunluk is number);
    }
    match /sinavlar/{t} {
      allow get: if t.size() >= 16 && (resource.data.durum == 'bekliyor' || sinavPersoneli());
      allow list: if sinavPersoneli();
      // Anahtar biçimi: yeni "s_" + 32 onaltılık (128 bit); eski sürümün bekleyen bağlantıları "as_…".
      allow create: if t.matches('(s_[0-9a-f]{32}|as_[a-z0-9]{8,24})')
        && (ik() || (yonetim() && request.resource.data.adayDepartman == isealimDep()))
        && request.resource.data.keys().hasOnly(sinavAlanlari())
        && request.resource.data.durum == 'bekliyor'
        && request.resource.data.olusturma == request.time
        && metin(request.resource.data.adayAd, 60);
      allow update: if ik() || sinavTamamlama();
      allow delete: if ik();
    }

    // ===================================================== AYRILIŞ ANKETİ
    // İstifayla ayrılan çalışana İK tek kullanımlık bağlantı üretir (anket.html#a_<32 onaltılık> = 128 bit).
    // Çalışan oturum açmaz: bağlantıdaki anahtarla YALNIZ bekleyen kendi kaydını okur ve BİR KEZ tamamlar;
    // cevaplar alan alan denetlenir. Tamamlanan anket bağlantıyla OKUNAMAZ ve değiştirilemez.
    // Sonuçları yalnız İK ve direktörler görür (ayrilis.html); bağlantıyı yalnız İK üretir / iptal eder.
    // Direktör YALNIZ tamamlanmış yanıtları okur: bekleyen kaydın kimliği gizli anahtarın kendisidir
    // (görebilen, çalışanın yerine anketi doldurabilirdi). Direktör sorgusu durum=='tamamlandi' süzgeçli olmalıdır.
    // Alan ve seçenek listeleri ortak/ayrilis-sorular.js ile BİREBİR aynıdır.
    function anketDirektoru() { return rol('direktor') && resource.data.durum == 'tamamlandi'; }
    function anketAnahtari(t) { return t.matches('a_[0-9a-f]{32}'); }
    function anketAlanlari() {
      return ['ad', 'departman', 'pozisyon', 'giris', 'cikis', 'durum', 'kaynak', 'olusturma', 'olusturan',
              'tamamlanma', 'cevaplar', 'ikKodu'];
    }
    function faktorler() {
      return ['tatmin', 'ucret', 'gorevBelirsiz', 'kariyer', 'yanHak', 'isyeri', 'yonetici', 'arkadas',
              'egitimYetersiz', 'odul', 'isYuku', 'saat', 'sektor', 'ailevi', 'sirketEgitim', 'evlilik',
              'askerlik', 'tasinma', 'saglik', 'kultur', 'okul', 'gorevDisi', 'isYasam'];
    }
    function puan(v) { return v is int && v >= 0 && v <= 5; }
    function puanlarGecerli(p) {
      return p is map && p.keys().hasOnly(faktorler()) && p.keys().hasAll(faktorler())
        && puan(p.tatmin) && puan(p.ucret) && puan(p.gorevBelirsiz) && puan(p.kariyer) && puan(p.yanHak)
        && puan(p.isyeri) && puan(p.yonetici) && puan(p.arkadas) && puan(p.egitimYetersiz) && puan(p.odul)
        && puan(p.isYuku) && puan(p.saat) && puan(p.sektor) && puan(p.ailevi) && puan(p.sirketEgitim)
        && puan(p.evlilik) && puan(p.askerlik) && puan(p.tasinma) && puan(p.saglik) && puan(p.kultur)
        && puan(p.okul) && puan(p.gorevDisi) && puan(p.isYasam);
    }
    function anketCevaplariGecerli(c) {
      let alanlar = ['puan', 'yonetici', 'diger', 'karar', 'kime', 'tekrar', 'olay', 'olayAciklama', 'kosul', 'dusunce', 'kvkk'];
      return c is map && c.keys().hasOnly(alanlar) && c.keys().hasAll(alanlar)
        && puanlarGecerli(c.puan)
        && metin(c.yonetici, 120) && c.yonetici.size() > 0
        && metin(c.diger, 1500) && metin(c.olayAciklama, 1500) && metin(c.kosul, 1500) && metin(c.dusunce, 1500)
        && c.karar in ['Bir hafta içinde', 'Bir ay içinde', 'Altı ay içinde', 'Uzun zamandan beri', 'İşe başladıktan hemen sonra']
        && c.kime is list && c.kime.size() >= 1 && c.kime.size() <= 2
        && c.kime.toSet().size() == c.kime.size() && c.kime.hasOnly(['Yöneticilerime', 'Mesai arkadaşlarıma'])
        && c.tekrar in ['Evet', 'Hayır']
        && c.olay in ['Evet', 'Hayır']
        && c.kvkk in ['ONAYLIYORUM.', 'ONAYLAMIYORUM.'];
    }
    function anketTamamlama() {
      let once = resource.data;
      let sonra = request.resource.data;
      return once.durum == 'bekliyor'
        && sonra.durum == 'tamamlandi'
        && sonra.diff(once).affectedKeys().hasOnly(['durum', 'cevaplar', 'tamamlanma'])
        && sonra.tamamlanma == request.time
        && anketCevaplariGecerli(sonra.cevaplar);
    }
    // İK kaydı: yeni bağlantı (bekliyor, cevapsız) ya da eski Google Form yanıtlarının aktarımı (tamamlandi).
    function anketKaydiGecerli() {
      let d = request.resource.data;
      return d.keys().hasOnly(anketAlanlari())
        && metin(d.ad, 80) && d.ad.size() > 0
        && d.olusturma == request.time
        && ((d.durum == 'bekliyor' && d.kaynak == 'link' && !('cevaplar' in d) && !('tamamlanma' in d))
            || (d.durum == 'tamamlandi' && d.kaynak in ['google_form', 'ik'] && d.cevaplar is map));
    }
    match /ayrilisAnketleri/{t} {
      allow get: if ik() || anketDirektoru() || (anketAnahtari(t) && resource.data.durum == 'bekliyor');
      allow list: if ik() || anketDirektoru();
      allow create: if ik() && anketAnahtari(t) && anketKaydiGecerli();
      allow update: if (anketAnahtari(t) && anketTamamlama()) || ik();
      allow delete: if ik();
    }

    // ================================================== ORYANTASYON FORMLARI
    // oryantasyon.html — İK her unvan için bir ANA FORM hazırlar (oryantasyonFormlari/{unvanKodu}); tüm yönetim
    // rolleri okur, yalnız İK yazar. Her kayıtta sürüm TAM 1 artar ve aynı toplu yazımda sürüm geçmişine
    // (oryantasyonFormlari/{kod}/surumler/{sürüm}) formun o anki hâli yazılır (iki İK aynı anda kaydederse biri reddedilir).
    // Her müdür/direktör ana formun KENDİ kopyasını düzenler: oryantasyonDuzenlemeleri/{unvanKodu}__{hid}.
    // Kopyayı yalnız sahibi oluşturur/günceller: kimlik ve ad hesaptan, zaman sunucu saatinden denetlenir; kopyadaki
    // "taban" (karşılaştırmanın yapıldığı ana form) sürüm geçmişindeki kayıtla BİREBİR aynı olmalıdır; "değişiklik
    // önerim yok" (onaylandi) ancak form tabanla aynıysa yazılabilir. Başka bir müdür okuyamaz. İK tümünü okur ama
    // başkasının kopyasını DEĞİŞTİREMEZ (yalnız silebilir). Müdür sorgusu hid süzgeçli olmalıdır.
    function unvanKodu(k) { return k is string && k.matches('[a-z0-9-]{3,40}'); }
    function oryFormYolu(kod) { return /databases/$(database)/documents/oryantasyonFormlari/$(kod); }
    function orySurumYolu(kod, n) { return /databases/$(database)/documents/oryantasyonFormlari/$(kod)/surumler/$(string(n)); }
    // Form yapısı: yalnız { alanlar: [...], bolumler: [...] }, sınırlar ortak/oryantasyon-fark.js EN_FAZLA ile aynı
    function oryFormSekli(f) {
      return f is map && f.keys().hasOnly(['alanlar', 'bolumler']) && f.keys().hasAll(['alanlar', 'bolumler'])
        && f.alanlar is list && f.alanlar.size() <= 30
        && f.bolumler is list && f.bolumler.size() <= 40;
    }
    function oryAnaGecerli(kod) {
      let d = request.resource.data;
      return d.keys().hasOnly(['kod', 'unvan', 'form', 'surum', 'guncelleme', 'guncelleyen', 'kaynak'])
        && d.keys().hasAll(['kod', 'unvan', 'form', 'surum', 'guncelleme', 'guncelleyen', 'kaynak'])
        && d.kod == kod
        && metin(d.unvan, 80) && metin(d.kaynak, 200) && d.guncelleyen == hesap().ad
        && oryFormSekli(d.form) && d.form.bolumler.size() >= 1
        && d.surum is int && d.surum == (resource == null ? 1 : resource.data.surum + 1)
        && d.guncelleme == request.time
        && existsAfter(orySurumYolu(kod, d.surum));
    }
    match /oryantasyonFormlari/{kod} {
      allow read: if yonetim();
      allow create, update: if ik() && unvanKodu(kod) && oryAnaGecerli(kod);
      allow delete: if ik();
      // Sürüm geçmişi: yalnız ana formla aynı toplu yazımda, ana formun YENİ sürümüyle birebir aynı içerikle yazılır
      match /surumler/{n} {
        allow read: if yonetim();
        allow create, update: if ik() && n.matches('[1-9][0-9]{0,5}')
          && request.resource.data.keys().hasOnly(['surum', 'form', 'guncelleme', 'guncelleyen'])
          && request.resource.data.surum == int(n)
          && getAfter(oryFormYolu(kod)).data.surum == int(n)
          && request.resource.data.form == getAfter(oryFormYolu(kod)).data.form
          && request.resource.data.guncelleyen == hesap().ad
          && request.resource.data.guncelleme == request.time;
        allow delete: if ik();
      }
    }
    // Aktif personel listesi (oryantasyon sorumlusu seçici): yalnız ad, unvan, departman. Tüm yönetim rolleri okur,
    // İK yazar (İK sayfayı açınca haftalık İK pano verisinden yeniden kurulur).
    // "epostalar": çalışan e-posta listesi (sorumlu bildirimi) — yalnız İK okur ve yazar.
    match /oryantasyonAyar/{d} {
      allow read: if (yonetim() && d == 'personel') || (ik() && d == 'epostalar');
      allow create, update: if ik() && d in ['personel', 'epostalar']
        && request.resource.data.keys().hasOnly(['liste', 'guncelleme', 'kaynak'])
        && request.resource.data.liste is list && request.resource.data.liste.size() <= 3000
        && metin(request.resource.data.kaynak, 80)
        && request.resource.data.guncelleme == request.time;
    }
    // Kişiye özel oryantasyon formu (yeni başlayan personel): yalnız İK. İK Dashboard (haftalık veri / işe giriş
    // hareketi) ya da oryantasyon.html açar; sorumlu bildirimleri "bildirimler" haritasında tutulur.
    function oryKisiAlanlari() {
      return ['kod', 'unvan', 'ad', 'dept', 'pozisyon', 'iseGiris', 'yonetici', 'form', 'taban', 'tabanSurum', 'durum', 'kaynak',
              'bildirimler', 'olusturma', 'olusturan', 'guncelleme', 'guncelleyen'];
    }
    match /oryantasyonKisiler/{id} {
      allow read, delete: if ik();
      allow create, update: if ik()
        && request.resource.data.keys().hasOnly(oryKisiAlanlari())
        && unvanKodu(request.resource.data.kod)
        && metin(request.resource.data.ad, 80) && request.resource.data.ad.size() >= 3
        && oryFormSekli(request.resource.data.form) && oryFormSekli(request.resource.data.taban)
        && request.resource.data.durum in ['hazirlanacak', 'hazirlandi']
        && request.resource.data.bildirimler is map
        && request.resource.data.guncelleme == request.time;
    }
    // SORUMLU DOLDURMA BAĞLANTISI (oryantasyon-sorumlu.html#y_<32 onaltılık>): her oryantasyon sorumlusuna kişiye özel,
    // giriş gerektirmeyen bağlantı. Belge kimliği gizli anahtardır (tahmin edilemez, listelenemez). Bağlantı kaydını
    // (planın tamamı = gorunum, sorumlunun satırları = satirlar) yalnız İK yazar; sorumlu yalnız okur (kayıt "acik" ise).
    // Sorumlu YALNIZ kendi satırlarının girdisini yazar: oryantasyonYetki/{t}/oryGirdi/{maddeKimligi} — madde kayıttaki
    // "satirlar" listesinde olmalı; alanlar yalnız Tarih (YYYY-AA-GG) / Saat (15 dakikalık) / Süre (listeden) / Not (≤500),
    // zaman SUNUCU saati. "ik" işareti (İK düzeltmesi) yalnız İK yazar. Silme yalnız İK. Kapalı bağlantı açılmaz, yazılmaz.
    function oryYetkiAnahtari(t) { return t.matches('y_[0-9a-f]{32}'); }
    function oryYetkiAlanlari() { return ['kisiId', 'ad', 'anahtar', 'kisi', 'satirlar', 'gorunum', 'durum', 'olusturma', 'guncelleme']; }
    function oryYetkiIk() {
      return request.resource.data.keys().hasOnly(oryYetkiAlanlari())
        && request.resource.data.kisiId is string && request.resource.data.kisiId.size() <= 60
        && metin(request.resource.data.ad, 80)
        && request.resource.data.satirlar is list && request.resource.data.satirlar.size() <= 200
        && request.resource.data.gorunum is map && request.resource.data.kisi is map
        && request.resource.data.durum in ['acik', 'kapali'];
    }
    function oryYetkiKaydi(t) { return get(/databases/$(database)/documents/oryantasyonYetki/$(t)).data; }
    // Sorumlu kendi satırına yazıyor mu: bağlantı açık ve madde bağlantının satırlarında (kayıt bir kez okunur)
    function oryGirdiSorumlu(t, m) {
      let y = oryYetkiKaydi(t);
      return y.durum == 'acik' && m in y.satirlar;
    }
    function oryGirdiGecerli() {
      return request.resource.data.keys().hasOnly(['termin', 'saat', 'sure', 'aciklama', 'zaman', 'ik'])
        && request.resource.data.keys().hasAll(['termin', 'saat', 'sure', 'aciklama', 'zaman'])
        && request.resource.data.termin is string && (request.resource.data.termin == '' || request.resource.data.termin.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        && request.resource.data.saat is string && (request.resource.data.saat == '' || request.resource.data.saat.matches('([01][0-9]|2[0-3]):(00|15|30|45)'))
        && request.resource.data.sure in ['', '30 dk', '1 saat', '2 saat', '4 saat', '8 saat', '2 gün', '3 gün']
        && metin(request.resource.data.aciklama, 500)
        && request.resource.data.zaman == request.time;
    }
    match /oryantasyonYetki/{t} {
      allow get: if ik() || (oryYetkiAnahtari(t) && resource.data.durum == 'acik');
      allow list, delete: if ik();
      allow create, update: if ik() && oryYetkiAnahtari(t) && oryYetkiIk();
      match /oryGirdi/{m} {
        allow get, list: if ik() || (oryYetkiAnahtari(t) && oryYetkiKaydi(t).durum == 'acik');
        allow create, update: if oryGirdiGecerli() && (
          (ik() && (!('ik' in request.resource.data) || request.resource.data.ik == true))
          || (oryYetkiAnahtari(t) && !('ik' in request.resource.data) && oryGirdiSorumlu(t, m)));
        allow delete: if ik();
      }
    }
    // İK: tüm bağlantıların satır girdileri tek sorguyla (koleksiyon grubu "oryGirdi")
    match /{yol=**}/oryGirdi/{m} {
      allow read: if ik();
    }
    // E-POSTA KUYRUĞU: İK yazar (durum "bekliyor"); gönderimi GitHub Actions görevi yapar (ise-alim-sureci deposu,
    // scripts/eposta-kuyrugu.js, yönetici hesabıyla — kural dışı). Yalnız şirket alan adına (@inciroglu.com.tr) gönderilir.
    // İK bekleyen e-postayı iptal edebilir; gönderilmiş kayıt değiştirilemez.
    match /epostaKuyrugu/{id} {
      allow read: if ik();
      allow create: if ik()
        && request.resource.data.keys().hasOnly(['kime', 'kimeAd', 'konu', 'html', 'kaynak', 'ilgili', 'durum', 'olusturma', 'olusturan'])
        && request.resource.data.kime is string && request.resource.data.kime.matches('[a-z0-9._%+-]+@inciroglu[.]com[.]tr')
        && metin(request.resource.data.kimeAd, 120) && !request.resource.data.kimeAd.matches('.*[@,;"].*')
        && metin(request.resource.data.konu, 200)
        && request.resource.data.html is string && request.resource.data.html.size() <= 60000
        && metin(request.resource.data.kaynak, 40) && metin(request.resource.data.ilgili, 120) && metin(request.resource.data.olusturan, 120)
        && request.resource.data.durum == 'bekliyor'
        && request.resource.data.olusturma == request.time;
      allow update: if ik() && resource.data.durum == 'bekliyor' && request.resource.data.durum == 'iptal'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['durum']);
      allow delete: if false;
    }
    // Rol adı hesaptaki gerçek role bağlıdır (oryantasyon.html ROL_ADI ile birebir). İK kopya oluşturmaz (sayılara karışmasın).
    function oryRolKodu() {
      return { 'Direktör': 'direktor', 'Satış Müdürü': 'satis_mudur', 'Servis Müdürü': 'servis_mudur',
               'İdari Müdür': 'idari_mudur', 'Departman Müdürü': 'mudur' };
    }
    function oryRolGecerli(r) {
      return r is string && r in oryRolKodu() && hesap().roller.hasAny([oryRolKodu()[r]]) && !hesap().roller.hasAny(['ik']);
    }
    // Hangi rol hangi unvanın formunu düzenleyebilir (oryantasyon.html ROL_UNVAN ile birebir, 13.11.2026):
    // satış müdürü → satış danışmanı + satış müdürü; servis müdürü → servis danışmanı + servis müdürü;
    // direktör, idari müdür, departman müdürü → hepsi
    function oryUnvanIzinli(kod) {
      let r = hesap().roller;
      return r.hasAny(['direktor', 'idari_mudur', 'mudur'])
        || (r.hasAny(['satis_mudur']) && kod in ['satis-danismani', 'satis-muduru'])
        || (r.hasAny(['servis_mudur']) && kod in ['servis-danismani', 'servis-muduru']);
    }
    function oryOzetAlanlari() {
      return ['degisen', 'eklenen', 'silinen', 'sira', 'bolumDegisen', 'bolumEklenen', 'bolumSilinen', 'bolumMaddeSilinen',
              'alanDegisen', 'alanEklenen', 'alanSilinen', 'toplam'];
    }
    function oryDuzenlemeGecerli(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['kod', 'hid', 'ad', 'rol', 'durum', 'form', 'taban', 'tabanSurum', 'ozet', 'olusturma', 'guncelleme'])
        && d.keys().hasAll(['kod', 'hid', 'ad', 'rol', 'durum', 'form', 'taban', 'tabanSurum', 'ozet', 'olusturma', 'guncelleme'])
        && unvanKodu(d.kod)
        && d.hid == benimHid()
        && id == d.kod + '__' + d.hid
        && d.ad == hesap().ad
        && oryRolGecerli(d.rol)
        && oryUnvanIzinli(d.kod)
        && d.durum in ['duzenlendi', 'onaylandi']
        && oryFormSekli(d.form) && oryFormSekli(d.taban)
        && d.ozet is map && d.ozet.keys().hasOnly(oryOzetAlanlari())
        && d.tabanSurum is int && d.tabanSurum >= 1
        && d.taban == get(orySurumYolu(d.kod, d.tabanSurum)).data.form
        && ((d.durum == 'onaylandi') == (d.form == d.taban))
        && d.guncelleme == request.time
        && (resource == null ? d.olusturma == request.time : d.olusturma == resource.data.olusturma);
    }
    match /oryantasyonDuzenlemeleri/{id} {
      allow get, list: if ik() || (gecerli() && resource.data.hid == benimHid());
      allow create, update: if yonetim() && oryDuzenlemeGecerli(id);
      allow delete: if ik() || (gecerli() && resource.data.hid == benimHid());
    }
  }
}
