rules_version = '2';

// =============================================================================
//  İnciroğlu Otomotiv · Cloud Firestore Güvenlik Kuralları
//  Sürüm 2026-10-10 · TÜM uygulamalar ortak girişte; tüm koleksiyonlar rol bazlı kilitli
// -----------------------------------------------------------------------------
//  İLKE: VARSAYILAN RED. Aşağıda açıkça izin verilmeyen her okuma/yazma reddedilir.
//  Kimlik  : Firebase Authentication (request.auth).
//  Yetki   : hesaplar/{hid} (roller + kapsam; YALNIZ İK yazar)
//            uidBag/{uid}   (Firebase oturumu ↔ hesap bağı; kişi yalnız geçerli
//                            aktivasyon koduyla KENDİ bağını kurar)
//  hid     : SHA-256("inciroglu-hesap|" + TC Kimlik No) — belge adlarında TC yoktur.
//  Herkese açık yalnız dört uç vardır: iş başvurusu OLUŞTURMA ve portal erişim talebi
//  OLUŞTURMA (ikisi de sıkı alan denetimiyle, okuma yok) ve tahmin edilemez anahtarla
//  tek bir sınav kaydı (aday sınavı) ile tek bir ayrılış anketi kaydı (12.11.2026).
//  Ayrıntılı açıklama ve değişiklik süreci: guvenlik/README.md
//  Yayın   : Firebase Konsolu → Firestore Database → Kurallar (Rules) → Yayınla.
// =============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------ yardımcılar
    function oturum() { return request.auth != null; }
    function yol(koleksiyon, kimlik) { return /databases/$(database)/documents/$(koleksiyon)/$(kimlik); }
    function bagli() { return oturum() && exists(yol('uidBag', request.auth.uid)); }
    function benimHid() { return get(yol('uidBag', request.auth.uid)).data.hid; }
    function hesap() { return get(yol('hesaplar', benimHid())).data; }
    // Geçerli hesap: oturum bir hesaba bağlı, hesap AKTİF ve hesabın GÜNCEL oturumu bu.
    // (İK yeni kod üretince ya da hesabı kapatınca eski oturumlar anında yetkisiz kalır.)
    function gecerli() { return bagli() && hesap().aktif == true && hesap().uid == request.auth.uid; }
    function rolden(roller) { return gecerli() && hesap().roller.hasAny(roller); }
    function rol(r) { return rolden([r]); }
    function ik() { return rol('ik'); }
    function yonetimRolleri() { return ['ik', 'direktor', 'satis_mudur', 'servis_mudur', 'idari_mudur', 'mudur']; }
    function yonetim() { return rolden(yonetimRolleri()); }
    function kapsam() { return hesap().kapsam; }
    function tcOzeti(tc) { return hashing.sha256('inciroglu-hesap|' + tc).toHexString().lower(); }
    // Metin alanı: tür + uzunluk sınırı + HTML etiketi yok (herkese açık formlardan betik enjeksiyonuna karşı)
    function metin(v, enFazla) { return v is string && v.size() <= enFazla && !v.matches('(?s).*[<>].*'); }

    // ====================================================== HESAP ALTYAPISI
    function hesapAlanlari() {
      return ['ad', 'tc', 'roller', 'kapsam', 'aktif', 'uid', 'kodHash', 'kodSon', 'kodDurum',
              'olusturan', 'olusturma', 'guncelleyen', 'guncelleme', 'aktivasyon'];
    }
    function rollerGecerli(r) {
      return r is list && r.size() >= 1 && r.size() <= 8
        && r.hasOnly(['calisan', 'ik', 'direktor', 'satis_mudur', 'servis_mudur', 'idari_mudur', 'mudur']);
    }
    function hesapVerisiGecerli(h, y) {
      return y.keys().hasOnly(hesapAlanlari())
        && metin(y.ad, 120) && y.ad.size() > 0
        && y.tc is string && y.tc.matches('[1-9][0-9]{10}')
        && tcOzeti(y.tc) == h
        && rollerGecerli(y.roller)
        && y.kapsam is map
        && y.aktif is bool;
    }
    // Kullanılmış bir aktivasyon kodu, eski bir kayıt üzerine yazılarak yeniden canlandırılamaz.
    function kodCanlanmiyor() {
      return resource == null
        || !(resource.data.kodDurum == 'kullanildi'
             && request.resource.data.kodDurum == 'bekliyor'
             && request.resource.data.kodHash == resource.data.kodHash);
    }
    // İK: hesap açar, rol/kapsam verir, aktivasyon kodu (yalnız özeti) üretir, hesabı kapatır.
    function ikHesapYazimi(h) { return ik() && hesapVerisiGecerli(h, request.resource.data) && kodCanlanmiyor(); }

    // Aktivasyon: kişi, İK'nın verdiği süreli kodla KENDİ hesabını yeni oturumuna bağlar.
    // Aynı toplu yazmada uidBag/{uid} de oluşturulur; kod özeti orada da aynı olmalıdır.
    function aktivasyon(h) {
      let once = resource.data;
      let sonra = request.resource.data;
      let bag = getAfter(yol('uidBag', request.auth.uid)).data;
      return oturum()
        && once.aktif == true
        && once.kodDurum == 'bekliyor'
        && once.kodSon is timestamp && once.kodSon > request.time
        && bag.hid == h
        && bag.kodHash == once.kodHash
        && sonra.diff(once).affectedKeys().hasOnly(['uid', 'kodDurum', 'aktivasyon'])
        && sonra.uid == request.auth.uid
        && sonra.kodDurum == 'kullanildi'
        && sonra.aktivasyon == request.time;
    }

    // TEK SEFERLİK KURULUM — ilk İK yöneticisinin hesabı. Kod kurala yalnız SHA-256 özeti olarak yazılıdır
    // (100 bit rastgele; tersine çevrilemez). kurulum/tek belgesi yalnız BİR KEZ oluşturulabildiği için kod
    // ikinci kez kullanılamaz; 24.10.2026'da da kendiliğinden kapanır. Kurulum bitince bu bölüm silinecektir.
    function kurulumKodu(kod) {
      return request.time < timestamp.date(2026, 10, 24)
        && kod is string && kod.size() == 20
        && hashing.sha256(kod).toHexString().lower() == 'ee77addb2ef20d04700a469ae611dda091b16faaab1b87c9b11f685685333e20';
    }
    function kurulumVar() {
      return oturum()
        && !exists(yol('kurulum', 'tek'))
        && existsAfter(yol('kurulum', 'tek'))
        && getAfter(yol('kurulum', 'tek')).data.uid == request.auth.uid
        && kurulumKodu(getAfter(yol('kurulum', 'tek')).data.kod);
    }
    function kurulumHesabi(h) {
      let y = request.resource.data;
      return kurulumVar()
        && hesapVerisiGecerli(h, y)
        && y.roller == ['calisan', 'ik']
        && y.kapsam.size() == 0
        && y.aktif == true
        && y.uid == request.auth.uid
        && y.kodDurum == 'kullanildi'
        && getAfter(yol('uidBag', request.auth.uid)).data.hid == h;
    }

    // hesaplar/{hid}: kişi başına bir kayıt (ad, tc, roller, kapsam, aktiflik, kod özeti).
    // Ajan Ofisi sahibinin hesabı (ve oturum bağı) sahip kaydı oluştuktan sonra yalnız sahibin kendisince değiştirilebilir:
    // başka bir İK kullanıcısı bu hesaba yeni aktivasyon kodu üretemez, uid'sini/rolünü değiştiremez, silemez.
    // "olusturan: kurulum" işareti yalnız tek seferlik kurulumda konur; İK sonradan hiçbir hesaba veremez.
    function sahipVar() { return exists(yol('ajanOfisi', 'sahip')); }
    function sahipKorumasi(h) { return !sahipVar() || h != get(yol('ajanOfisi', 'sahip')).data.hid || (gecerli() && benimHid() == h); }
    function kurulumIsaretiKorunur() {
      return request.resource.data.get('olusturan', '') != 'kurulum'
        || (resource != null && resource.data.get('olusturan', '') == 'kurulum');
    }
    // Kurucu hesap: kurulum koduyla açılmış İK hesabı (Ajan Ofisi sahibi olabilecek ve prim erişim listesini yöneten hesap).
    function kurucuHesap() {
      return gecerli() && hesap().roller.hasAny(['ik'])
        && (hesap().get('olusturan', '') == 'kurulum' || request.auth.uid == get(yol('kurulum', 'tek')).data.uid);
    }
    // PRİM KORUMASI (19.11.2026): Müdür Prim Sistemleri erişim listesindeki (primAyar/erisim) bir hesabın kaydını (rol, uid,
    // aktivasyon kodu) ve oturum bağını yalnız kurucu hesap ya da kişinin kendisi değiştirebilir. Böylece İK rolündeki başka
    // biri listedeki bir hesabı devralarak (uid / bağ değiştirerek ya da yeni kod üreterek) prim verisine erişemez.
    function primListe() { return get(yol('primAyar', 'erisim')).data.hidler; }
    function primKorumasi(h) {
      return !exists(yol('primAyar', 'erisim')) || !(h in primListe()) || kurucuHesap() || (gecerli() && benimHid() == h);
    }
    // GÖRÜŞME KORUMASI (24.11.2026): Görüşme Detayları erişim listesindeki (gorusmeAyar/erisim) hesaplar da aynı biçimde korunur
    // (aday kişisel verisine başka bir İK kullanıcısı listedeki hesabı devralarak erişemez). İki koruma birlikte uygulanır.
    function gorusmeListe() { return get(yol('gorusmeAyar', 'erisim')).data.hidler; }
    function gorusmeKorumasi(h) {
      return !exists(yol('gorusmeAyar', 'erisim')) || !(h in gorusmeListe()) || kurucuHesap() || (gecerli() && benimHid() == h);
    }
    // SAVUNMA KORUMASI (25.11.2026): Savunma Talepleri İK ekibi listesindeki (savunmaAyar/erisim) hesaplar da aynı biçimde korunur.
    function svListe() { return get(yol('savunmaAyar', 'erisim')).data.hidler; }
    function svKorumasi(h) {
      return !exists(yol('savunmaAyar', 'erisim')) || !(h in svListe()) || kurucuHesap() || (gecerli() && benimHid() == h);
    }
    function listeKorumasi(h) { return primKorumasi(h) && gorusmeKorumasi(h) && svKorumasi(h); }
    // Savunma Talepleri İK ekibi = kurucu hesap + savunmaAyar/erisim listesi (kullanımı: SAVUNMA TALEPLERİ bölümü ve svEposta)
    function svIk() { return kurucuHesap() || (gecerli() && exists(yol('savunmaAyar', 'erisim')) && benimHid() in svListe()); }
    match /hesaplar/{h} {
      allow get: if ik() || (gecerli() && benimHid() == h);
      allow list: if ik();
      allow create: if (ikHesapYazimi(h) && kurulumIsaretiKorunur() && sahipKorumasi(h) && listeKorumasi(h)) || kurulumHesabi(h);
      allow update: if (ikHesapYazimi(h) && kurulumIsaretiKorunur() && sahipKorumasi(h) && listeKorumasi(h)) || aktivasyon(h);
      allow delete: if ik() && sahipKorumasi(h) && listeKorumasi(h);
    }

    // uidBag/{uid}: Firebase oturumu ↔ hesap bağı. Yalnız oturum sahibi, yalnız geçerli kodla kurar.
    function kodlaBag(b) {
      return exists(yol('hesaplar', b.hid))
        && get(yol('hesaplar', b.hid)).data.aktif == true
        && get(yol('hesaplar', b.hid)).data.kodDurum == 'bekliyor'
        && get(yol('hesaplar', b.hid)).data.kodHash == b.kodHash
        && get(yol('hesaplar', b.hid)).data.kodSon is timestamp
        && get(yol('hesaplar', b.hid)).data.kodSon > request.time;
    }
    match /uidBag/{u} {
      allow get: if (oturum() && request.auth.uid == u) || ik();
      allow list: if ik();
      allow create: if oturum() && request.auth.uid == u
        && request.resource.data.keys().hasOnly(['hid', 'kodHash', 'ts'])
        && request.resource.data.hid is string
        && request.resource.data.kodHash is string
        && request.resource.data.ts == request.time
        && existsAfter(yol('hesaplar', request.resource.data.hid))
        && getAfter(yol('hesaplar', request.resource.data.hid)).data.uid == u
        && (kodlaBag(request.resource.data) || kurulumVar());
      allow update: if ik() && sahipKorumasi(resource.data.hid) && sahipKorumasi(request.resource.data.hid)
        && listeKorumasi(resource.data.hid) && listeKorumasi(request.resource.data.hid);
      allow delete: if ik() && sahipKorumasi(resource.data.hid) && listeKorumasi(resource.data.hid);
    }

    // kurulum/tek: tek seferlik kurulum kaydı (yalnız süre içinde, doğru kodla, YALNIZ BİR KEZ oluşturulabilir).
    match /kurulum/{id} {
      allow create: if id == 'tek' && oturum()
        && request.resource.data.keys().hasOnly(['kod', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && kurulumKodu(request.resource.data.kod);
      allow get, list: if ik();
    }

    // girisAdresi/{hid}: TC ile girişte kişinin Firebase hesabını bulmak için. Yalnız TEK belge
    // okunabilir (listeleme yok); içinde kişisel veri yoktur (sisteme özel e-posta adresi).
    match /girisAdresi/{h} {
      allow get: if true;
      allow list: if false;
      allow create, update: if oturum()
        && request.resource.data.keys().hasOnly(['e'])
        && request.resource.data.e == request.auth.token.email
        && getAfter(yol('uidBag', request.auth.uid)).data.hid == h
        && getAfter(yol('hesaplar', h)).data.uid == request.auth.uid;
      allow delete: if ik() && listeKorumasi(h);
    }

    // ============================================== İK + SATIŞ (satisVeri)
    // satisVeri koleksiyonu tarihsel nedenle hem satış panosunun canlı verisini ('current') hem İK
    // belgelerini (özlük, izin, harcama, puantaj, giriş-çıkış, ...) barındırır; kurallar BELGE bazında ayrıştırır.
    match /satisVeri/{belge} {
      // Satış panosu: İK (yönetici), direktör (görüntüleyici), satış müdürü okur.
      allow get: if belge == 'current' && rolden(['ik', 'direktor', 'satis_mudur']);
      // Satış müdürü yalnız elle girilen alanları değiştirebilir (eski çalışan, manuel danışman/fiili).
      allow update: if belge == 'current' && rol('satis_mudur')
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['eskiCalisanlar', 'manuelDanismanlar', 'manuelFiili', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
      // Personel listesinin kişisel veri İÇERMEYEN özeti (ad, departman, bölüm, unvan, tarihler).
      allow get: if belge == 'mrPersonelOzet' && yonetim();
      // İK Analitik Panosu verisi.
      allow get: if belge == 'ikPano' && rolden(['ik', 'direktor', 'idari_mudur']);
      // Satış danışmanlarının giriş/çıkış tarihi ve ayrılış notu (kişisel veri): yalnız İK ve direktör.
      allow get: if belge == 'danismanDetay' && rolden(['ik', 'direktor']);
      // İK: tüm belgeler (satış verisi dahil; Excel köprüsü İK oturumunda çalışır).
      allow read, write: if ik();
    }
    // Satış karneleri ve hedef tebliğleri. (Marka bazlı ayrım arayüzde yapılır; bkz. README.)
    // Müdür yazımında kayıt kimliği belge kimliğiyle aynı ve yalnız harf/rakam, yıl/ay sayı olmalıdır.
    function satisKaydiGecerli(id) {
      let d = request.resource.data;
      return id.matches('[A-Za-z0-9_-]{1,64}') && d.id == id && d.yil is number && d.ay is number;
    }
    match /satisKarneler/{id} {
      allow read: if rolden(['ik', 'direktor', 'satis_mudur']);
      allow create, update: if ik() || (rol('satis_mudur') && satisKaydiGecerli(id));
      allow delete: if rolden(['ik', 'satis_mudur']);
    }
    match /satisTebligler/{id} {
      allow read: if rolden(['ik', 'direktor', 'satis_mudur']);
      allow create, update: if ik() || (rol('satis_mudur') && satisKaydiGecerli(id));
      allow delete: if rolden(['ik', 'satis_mudur']);
    }

    // ============================================================== SERVİS
    function servisMarkasi() { return kapsam().servisMarka; }
    match /servisVeri/{belge} {
      allow read: if rolden(['ik', 'direktor', 'servis_mudur']);
      // Servis müdürü yalnız kadroya (elle danışman ekleme) dokunabilir; metrik ve marka tanımları İK'da.
      allow update: if belge == 'current' && rol('servis_mudur')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kadro', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
      allow write: if ik();
    }
    match /servisTebligler/{id} {
      allow read: if ik() || rol('direktor') || (rol('servis_mudur') && resource.data.marka == servisMarkasi());
      allow create: if ik() || (rol('servis_mudur') && request.resource.data.marka == servisMarkasi());
      allow update: if ik() || (rol('servis_mudur') && resource.data.marka == servisMarkasi() && request.resource.data.marka == servisMarkasi());
      allow delete: if ik();
    }
    match /servisKarneler/{id} {
      allow read: if ik() || rol('direktor') || (rol('servis_mudur') && resource.data.marka == servisMarkasi());
      allow create: if ik() || (rol('servis_mudur') && request.resource.data.marka == servisMarkasi());
      allow update: if ik() || (rol('servis_mudur') && resource.data.marka == servisMarkasi() && request.resource.data.marka == servisMarkasi());
      allow delete: if ik();
    }

    // ====================================================== YETENEK HAVUZU
    match /employees/{id} {
      allow read: if yonetim();
      allow write: if ik();
    }
    // Arşiv işareti yalnız İK'nındır; değerlendirici onu ekleyemez ya da değiştiremez.
    function arsivDegismiyor() {
      return resource == null
        ? !('arsiv' in request.resource.data)
        : !request.resource.data.diff(resource.data).affectedKeys().hasAny(['arsiv']);
    }
    // Değerlendirme, giren kişinin oturumu ve hesabındaki adıyla imzalanır; zaman sunucu saatidir
    // (başkası adına ya da geçmiş tarihli kayıt bırakılamaz). Belge kimliği "dönem::personel" biçimindedir.
    function degerlendirmeImzali(id) {
      let d = request.resource.data;
      return d.submittedByUid == request.auth.uid
        && d.submittedByName == hesap().ad
        && d.updatedAt == request.time
        && id == d.donem + '::' + d.employeeId
        && arsivDegismiyor();
    }
    // TAMAMLANMIŞ bir değerlendirmeyi yalnız onu tamamlayan kişi (ya da İK) değiştirebilir; taslak devam ettirilebilir.
    function tamamlanmisDegil() {
      return resource.data.get('status', '') != 'tamamlandi'
        || resource.data.get('submittedByUid', '') == request.auth.uid;
    }
    match /evaluations/{id} {
      allow read: if yonetim();
      allow create: if ik() || (yonetim() && degerlendirmeImzali(id));
      allow update: if ik() || (yonetim() && degerlendirmeImzali(id) && tamamlanmisDegil());
      allow delete: if ik();
    }
    // Değerlendirici kapsam profilleri ve dönem ayarı
    match /managers/{id} {
      allow read: if yonetim();
      allow write: if ik();
    }

    // ============================================================= İŞE ALIM
    function isealimDep() { return kapsam().isealimDepartman; }
    // Herkese açık iş başvurusu (basvuru.html): yalnız OLUŞTURMA; alanlar, türler, uzunluklar ve başlangıç
    // durumu sıkı denetlenir; HTML etiketi kabul edilmez. Okuma/güncelleme/silme herkese KAPALI.
    // CV yalnız PDF / Word olabilir (HTML, SVG vb. çalıştırılabilir içerik reddedilir); en fazla ~600 KB.
    function cvTurleri() {
      return ['application/pdf', 'application/msword',
              'application/vnd.openxmlformats-officedocument.wordprocessingml.document'];
    }
    function cvGecerli(c) {
      return c is map && c.keys().hasOnly(['ad', 'tip', 'boyut', 'veri'])
        && metin(c.ad, 200) && c.tip in cvTurleri()
        && c.boyut is int && c.boyut > 0 && c.boyut <= 650000
        && c.veri is string && c.veri.size() <= 900000
        && c.veri.matches('data:' + c.tip + ';base64,[A-Za-z0-9+/=]+');
    }
    function basvuruGecerli() {
      let d = request.resource.data;
      let p = d.basvurulanPozisyonlar;
      let g = d.gecmis;
      return d.keys().hasOnly(['ad', 'soyad', 'telefon', 'email', 'yas', 'yer', 'unvan', 'basvurulanPozisyonlar',
                               'departman', 'deneyimYil', 'deneyim', 'notlar', 'durum', 'kaynak', 'basvuruTarihi',
                               'evraklar', 'degerlendirmeler', 'etiketler', 'gecmis', 'olusturmaTarihi',
                               'guncellemeTarihi', 'cv'])
        && metin(d.ad, 60) && d.ad.size() > 0 && metin(d.soyad, 60) && d.soyad.size() > 0
        && metin(d.telefon, 30) && metin(d.email, 120) && metin(d.yer, 80)
        && (d.yas == null || (d.yas is int && d.yas >= 14 && d.yas <= 90))
        && metin(d.unvan, 120) && metin(d.departman, 60) && metin(d.deneyimYil, 40)
        && metin(d.deneyim, 4000) && metin(d.notlar, 4000) && metin(d.basvuruTarihi, 10)
        && p is list && p.size() >= 1 && p.size() <= 3
        && metin(p[0], 120) && (p.size() < 2 || metin(p[1], 120)) && (p.size() < 3 || metin(p[2], 120))
        && d.durum == 'gorusme_bekliyor' && d.kaynak == 'Web Başvurusu'
        && d.evraklar == [] && d.degerlendirmeler == [] && d.etiketler == []
        && g is list && g.size() == 1 && g[0] is map
        && g[0].keys().hasOnly(['tarih', 'eskiDurum', 'yeniDurum', 'kullanici', 'not'])
        && metin(g[0].tarih, 10) && g[0].eskiDurum == null && g[0].yeniDurum == 'gorusme_bekliyor'
        && g[0].kullanici == 'Web Başvurusu' && metin(g[0].not, 300)
        && d.olusturmaTarihi == request.time && d.guncellemeTarihi == request.time
        && (!('cv' in d) || cvGecerli(d.cv));
    }
    // Yeni kayıt kimliği yalnız Firestore'un otomatik ürettiği biçimde olabilir (20 harf/rakam): kimliğe
    // HTML/kod gömülemez.
    function otomatikKimlik(id) { return id.matches('[A-Za-z0-9]{20}'); }
    match /iseAlimAday/{id} {
      allow read: if ik() || (yonetim() && resource.data.departman == isealimDep());
      allow create: if otomatikKimlik(id)
        && (ik() || (yonetim() && request.resource.data.departman == isealimDep()) || basvuruGecerli());
      allow update: if ik() || (yonetim() && resource.data.departman == isealimDep()
                                && request.resource.data.departman == isealimDep());
      allow delete: if ik();
    }
    match /personelTalepleri/{id} {
      allow read: if ik() || (yonetim() && resource.data.departman == isealimDep());
      allow create: if otomatikKimlik(id)
        && (ik() || (yonetim() && request.resource.data.departman == isealimDep()));
      allow update: if ik() || (yonetim() && resource.data.departman == isealimDep()
                                && request.resource.data.departman == isealimDep());
      allow delete: if ik();
    }
    // Portal erişim talebi (IK-PLATFORM/tanitim.html formu): herkes YALNIZ yeni kayıt oluşturur; okuma,
    // durum güncelleme ve silme yalnız İK (İşe Alım → Personel Talepleri → Portal Erişim Talepleri).
    // Talep hiçbir yetki vermez; hesap yine İK tarafından hesaplar/ altında açılır.
    function erisimTalebiGecerli() {
      let d = request.resource.data;
      return d.keys().hasOnly(['ad', 'eposta', 'marka', 'rol', 'not', 'onay', 'durum', 'kaynak', 'olusturma'])
        && d.keys().hasAll(['ad', 'eposta', 'marka', 'rol', 'not', 'onay', 'durum', 'kaynak', 'olusturma'])
        && d.onay == true
        && metin(d.ad, 80) && d.ad.size() >= 3
        && metin(d.eposta, 120) && d.eposta.matches('[^@ ]+@[^@ ]+[.][^@ ]+')
        && metin(d.marka, 60) && d.marka.size() > 0
        && metin(d.rol, 60) && d.rol.size() > 0
        && metin(d.not, 500)
        && d.durum == 'yeni' && d.kaynak == 'Tanıtım Sayfası'
        && d.olusturma == request.time;
    }
    match /erisimTalepleri/{id} {
      allow read, update, delete: if ik();
      allow create: if otomatikKimlik(id) && erisimTalebiGecerli();
    }
    // Aday sınavı: aday yalnız bağlantıdaki tahmin edilemez anahtarla (128 bit) TEK kaydı okur ve BİR KEZ
    // tamamlar; aday dosyasına ve İK notlarına erişemez. Tamamlanan sınavın sonuçları bağlantıyla OKUNAMAZ
    // (yalnız İK / ilgili departman). Listeleme yalnız İK / ilgili departman.
    function sinavPersoneli() {
      return ik() || (yonetim() && resource.data.adayDepartman == isealimDep());
    }
    function sinavAlanlari() {
      return ['adayId', 'adayDepartman', 'adayAd', 'pozisyon', 'pozisyonAd', 'durum', 'olusturma'];
    }
    function sinavTamamlama() {
      let once = resource.data;
      let sonra = request.resource.data;
      return once.durum == 'bekliyor'
        && sonra.durum == 'tamamlandi'
        && sonra.diff(once).affectedKeys().hasOnly(['durum', 'tamamlanmaTarihi', 'boyutlar', 'uygunluk', 'gecerlik', 'cevaplar', 'tamamlanma'])
        && sonra.tamamlanma == request.time
        && metin(sonra.tamamlanmaTarihi, 10)
        && sonra.boyutlar is map && sonra.gecerlik is map && sonra.cevaplar is map
        && (sonra.uygunluk == null || sonra.uygunluk is number);
    }
    match /sinavlar/{t} {
      allow get: if t.size() >= 16 && (resource.data.durum == 'bekliyor' || sinavPersoneli());
      allow list: if sinavPersoneli();
      // Anahtar biçimi: yeni "s_" + 32 onaltılık (128 bit); eski sürümün bekleyen bağlantıları "as_…".
      allow create: if t.matches('(s_[0-9a-f]{32}|as_[a-z0-9]{8,24})')
        && (ik() || (yonetim() && request.resource.data.adayDepartman == isealimDep()))
        && request.resource.data.keys().hasOnly(sinavAlanlari())
        && request.resource.data.durum == 'bekliyor'
        && request.resource.data.olusturma == request.time
        && metin(request.resource.data.adayAd, 60);
      allow update: if ik() || sinavTamamlama();
      allow delete: if ik();
    }

    // ===================================================== AYRILIŞ ANKETİ
    // İstifayla ayrılan çalışana İK tek kullanımlık bağlantı üretir (anket.html#a_<32 onaltılık> = 128 bit).
    // Çalışan oturum açmaz: bağlantıdaki anahtarla YALNIZ bekleyen kendi kaydını okur ve BİR KEZ tamamlar;
    // cevaplar alan alan denetlenir. Tamamlanan anket bağlantıyla OKUNAMAZ ve değiştirilemez.
    // Sonuçları yalnız İK ve direktörler görür (ayrilis.html); bağlantıyı yalnız İK üretir / iptal eder.
    // Direktör YALNIZ tamamlanmış yanıtları okur: bekleyen kaydın kimliği gizli anahtarın kendisidir
    // (görebilen, çalışanın yerine anketi doldurabilirdi). Direktör sorgusu durum=='tamamlandi' süzgeçli olmalıdır.
    // Alan ve seçenek listeleri ortak/ayrilis-sorular.js ile BİREBİR aynıdır.
    function anketDirektoru() { return rol('direktor') && resource.data.durum == 'tamamlandi'; }
    function anketAnahtari(t) { return t.matches('a_[0-9a-f]{32}'); }
    function anketAlanlari() {
      return ['ad', 'departman', 'pozisyon', 'giris', 'cikis', 'durum', 'kaynak', 'olusturma', 'olusturan',
              'tamamlanma', 'cevaplar', 'ikKodu'];
    }
    function faktorler() {
      return ['tatmin', 'ucret', 'gorevBelirsiz', 'kariyer', 'yanHak', 'isyeri', 'yonetici', 'arkadas',
              'egitimYetersiz', 'odul', 'isYuku', 'saat', 'sektor', 'ailevi', 'sirketEgitim', 'evlilik',
              'askerlik', 'tasinma', 'saglik', 'kultur', 'okul', 'gorevDisi', 'isYasam'];
    }
    function puan(v) { return v is int && v >= 0 && v <= 5; }
    function puanlarGecerli(p) {
      return p is map && p.keys().hasOnly(faktorler()) && p.keys().hasAll(faktorler())
        && puan(p.tatmin) && puan(p.ucret) && puan(p.gorevBelirsiz) && puan(p.kariyer) && puan(p.yanHak)
        && puan(p.isyeri) && puan(p.yonetici) && puan(p.arkadas) && puan(p.egitimYetersiz) && puan(p.odul)
        && puan(p.isYuku) && puan(p.saat) && puan(p.sektor) && puan(p.ailevi) && puan(p.sirketEgitim)
        && puan(p.evlilik) && puan(p.askerlik) && puan(p.tasinma) && puan(p.saglik) && puan(p.kultur)
        && puan(p.okul) && puan(p.gorevDisi) && puan(p.isYasam);
    }
    function anketCevaplariGecerli(c) {
      let alanlar = ['puan', 'yonetici', 'diger', 'karar', 'kime', 'tekrar', 'olay', 'olayAciklama', 'kosul', 'dusunce', 'kvkk'];
      return c is map && c.keys().hasOnly(alanlar) && c.keys().hasAll(alanlar)
        && puanlarGecerli(c.puan)
        && metin(c.yonetici, 120) && c.yonetici.size() > 0
        && metin(c.diger, 1500) && metin(c.olayAciklama, 1500) && metin(c.kosul, 1500) && metin(c.dusunce, 1500)
        && c.karar in ['Bir hafta içinde', 'Bir ay içinde', 'Altı ay içinde', 'Uzun zamandan beri', 'İşe başladıktan hemen sonra']
        && c.kime is list && c.kime.size() >= 1 && c.kime.size() <= 2
        && c.kime.toSet().size() == c.kime.size() && c.kime.hasOnly(['Yöneticilerime', 'Mesai arkadaşlarıma'])
        && c.tekrar in ['Evet', 'Hayır']
        && c.olay in ['Evet', 'Hayır']
        && c.kvkk in ['ONAYLIYORUM.', 'ONAYLAMIYORUM.'];
    }
    function anketTamamlama() {
      let once = resource.data;
      let sonra = request.resource.data;
      return once.durum == 'bekliyor'
        && sonra.durum == 'tamamlandi'
        && sonra.diff(once).affectedKeys().hasOnly(['durum', 'cevaplar', 'tamamlanma'])
        && sonra.tamamlanma == request.time
        && anketCevaplariGecerli(sonra.cevaplar);
    }
    // İK kaydı: yeni bağlantı (bekliyor, cevapsız) ya da eski Google Form yanıtlarının aktarımı (tamamlandi).
    function anketKaydiGecerli() {
      let d = request.resource.data;
      return d.keys().hasOnly(anketAlanlari())
        && metin(d.ad, 80) && d.ad.size() > 0
        && d.olusturma == request.time
        && ((d.durum == 'bekliyor' && d.kaynak == 'link' && !('cevaplar' in d) && !('tamamlanma' in d))
            || (d.durum == 'tamamlandi' && d.kaynak in ['google_form', 'ik'] && d.cevaplar is map));
    }
    match /ayrilisAnketleri/{t} {
      allow get: if ik() || anketDirektoru() || (anketAnahtari(t) && resource.data.durum == 'bekliyor');
      allow list: if ik() || anketDirektoru();
      allow create: if ik() && anketAnahtari(t) && anketKaydiGecerli();
      allow update: if (anketAnahtari(t) && anketTamamlama()) || ik();
      allow delete: if ik();
    }

    // ================================================== ORYANTASYON FORMLARI
    // oryantasyon.html — İK her unvan için bir ANA FORM hazırlar (oryantasyonFormlari/{unvanKodu}); tüm yönetim
    // rolleri okur, yalnız İK yazar. Her kayıtta sürüm TAM 1 artar ve aynı toplu yazımda sürüm geçmişine
    // (oryantasyonFormlari/{kod}/surumler/{sürüm}) formun o anki hâli yazılır (iki İK aynı anda kaydederse biri reddedilir).
    // Her müdür/direktör ana formun KENDİ kopyasını düzenler: oryantasyonDuzenlemeleri/{unvanKodu}__{hid}.
    // Kopyayı yalnız sahibi oluşturur/günceller: kimlik ve ad hesaptan, zaman sunucu saatinden denetlenir; kopyadaki
    // "taban" (karşılaştırmanın yapıldığı ana form) sürüm geçmişindeki kayıtla BİREBİR aynı olmalıdır; "değişiklik
    // önerim yok" (onaylandi) ancak form tabanla aynıysa yazılabilir. Başka bir müdür okuyamaz. İK tümünü okur ama
    // başkasının kopyasını DEĞİŞTİREMEZ (yalnız silebilir). Müdür sorgusu hid süzgeçli olmalıdır.
    function unvanKodu(k) { return k is string && k.matches('[a-z0-9-]{3,40}'); }
    function oryFormYolu(kod) { return /databases/$(database)/documents/oryantasyonFormlari/$(kod); }
    function orySurumYolu(kod, n) { return /databases/$(database)/documents/oryantasyonFormlari/$(kod)/surumler/$(string(n)); }
    // Form yapısı: yalnız { alanlar: [...], bolumler: [...] }, sınırlar ortak/oryantasyon-fark.js EN_FAZLA ile aynı
    function oryFormSekli(f) {
      return f is map && f.keys().hasOnly(['alanlar', 'bolumler']) && f.keys().hasAll(['alanlar', 'bolumler'])
        && f.alanlar is list && f.alanlar.size() <= 30
        && f.bolumler is list && f.bolumler.size() <= 40;
    }
    function oryAnaGecerli(kod) {
      let d = request.resource.data;
      return d.keys().hasOnly(['kod', 'unvan', 'form', 'surum', 'guncelleme', 'guncelleyen', 'kaynak'])
        && d.keys().hasAll(['kod', 'unvan', 'form', 'surum', 'guncelleme', 'guncelleyen', 'kaynak'])
        && d.kod == kod
        && metin(d.unvan, 80) && metin(d.kaynak, 200) && d.guncelleyen == hesap().ad
        && oryFormSekli(d.form) && d.form.bolumler.size() >= 1
        && d.surum is int && d.surum == (resource == null ? 1 : resource.data.surum + 1)
        && d.guncelleme == request.time
        && existsAfter(orySurumYolu(kod, d.surum));
    }
    match /oryantasyonFormlari/{kod} {
      allow read: if yonetim();
      allow create, update: if ik() && unvanKodu(kod) && oryAnaGecerli(kod);
      allow delete: if ik();
      // Sürüm geçmişi: yalnız ana formla aynı toplu yazımda, ana formun YENİ sürümüyle birebir aynı içerikle yazılır
      match /surumler/{n} {
        allow read: if yonetim();
        allow create, update: if ik() && n.matches('[1-9][0-9]{0,5}')
          && request.resource.data.keys().hasOnly(['surum', 'form', 'guncelleme', 'guncelleyen'])
          && request.resource.data.surum == int(n)
          && getAfter(oryFormYolu(kod)).data.surum == int(n)
          && request.resource.data.form == getAfter(oryFormYolu(kod)).data.form
          && request.resource.data.guncelleyen == hesap().ad
          && request.resource.data.guncelleme == request.time;
        allow delete: if ik();
      }
    }
    // Aktif personel listesi (oryantasyon sorumlusu seçici): yalnız ad, unvan, departman. Tüm yönetim rolleri okur,
    // İK yazar (İK sayfayı açınca haftalık İK pano verisinden yeniden kurulur).
    // "epostalar": çalışan e-posta listesi (sorumlu bildirimi) — yalnız İK okur ve yazar.
    match /oryantasyonAyar/{d} {
      allow read: if (yonetim() && d == 'personel') || (ik() && d == 'epostalar');
      allow create, update: if ik() && d in ['personel', 'epostalar']
        && request.resource.data.keys().hasOnly(['liste', 'guncelleme', 'kaynak'])
        && request.resource.data.liste is list && request.resource.data.liste.size() <= 3000
        && metin(request.resource.data.kaynak, 80)
        && request.resource.data.guncelleme == request.time;
    }
    // Kişiye özel oryantasyon formu (yeni başlayan personel): yalnız İK. İK Dashboard (haftalık veri / işe giriş
    // hareketi) ya da oryantasyon.html açar; sorumlu bildirimleri "bildirimler" haritasında tutulur.
    function oryKisiAlanlari() {
      return ['kod', 'unvan', 'ad', 'dept', 'pozisyon', 'iseGiris', 'yonetici', 'form', 'taban', 'tabanSurum', 'durum', 'kaynak',
              'bildirimler', 'olusturma', 'olusturan', 'guncelleme', 'guncelleyen'];
    }
    match /oryantasyonKisiler/{id} {
      allow read, delete: if ik();
      allow create, update: if ik()
        && request.resource.data.keys().hasOnly(oryKisiAlanlari())
        && unvanKodu(request.resource.data.kod)
        && metin(request.resource.data.ad, 80) && request.resource.data.ad.size() >= 3
        && oryFormSekli(request.resource.data.form) && oryFormSekli(request.resource.data.taban)
        && request.resource.data.durum in ['hazirlanacak', 'hazirlandi']
        && request.resource.data.bildirimler is map
        && request.resource.data.guncelleme == request.time;
    }
    // SORUMLU DOLDURMA BAĞLANTISI (oryantasyon-sorumlu.html#y_<32 onaltılık>): her oryantasyon sorumlusuna kişiye özel,
    // giriş gerektirmeyen bağlantı. Belge kimliği gizli anahtardır (tahmin edilemez, listelenemez). Bağlantı kaydını
    // (planın tamamı = gorunum, sorumlunun satırları = satirlar) yalnız İK yazar; sorumlu yalnız okur (kayıt "acik" ise).
    // Sorumlu YALNIZ kendi satırlarının girdisini yazar: oryantasyonYetki/{t}/oryGirdi/{maddeKimligi} — madde kayıttaki
    // "satirlar" listesinde olmalı; alanlar yalnız Tarih (YYYY-AA-GG) / Saat (15 dakikalık) / Süre (listeden) / Not (≤500),
    // zaman SUNUCU saati. "ik" işareti (İK düzeltmesi) yalnız İK yazar. Silme yalnız İK. Kapalı bağlantı açılmaz, yazılmaz.
    function oryYetkiAnahtari(t) { return t.matches('y_[0-9a-f]{32}'); }
    function oryYetkiAlanlari() { return ['kisiId', 'ad', 'anahtar', 'kisi', 'satirlar', 'gorunum', 'durum', 'olusturma', 'guncelleme']; }
    function oryYetkiIk() {
      return request.resource.data.keys().hasOnly(oryYetkiAlanlari())
        && request.resource.data.kisiId is string && request.resource.data.kisiId.size() <= 60
        && metin(request.resource.data.ad, 80)
        && request.resource.data.satirlar is list && request.resource.data.satirlar.size() <= 200
        && request.resource.data.gorunum is map && request.resource.data.kisi is map
        && request.resource.data.durum in ['acik', 'kapali'];
    }
    function oryYetkiKaydi(t) { return get(/databases/$(database)/documents/oryantasyonYetki/$(t)).data; }
    // Sorumlu kendi satırına yazıyor mu: bağlantı açık ve madde bağlantının satırlarında (kayıt bir kez okunur)
    function oryGirdiSorumlu(t, m) {
      let y = oryYetkiKaydi(t);
      return y.durum == 'acik' && m in y.satirlar;
    }
    function oryGirdiGecerli() {
      return request.resource.data.keys().hasOnly(['termin', 'saat', 'sure', 'aciklama', 'zaman', 'ik'])
        && request.resource.data.keys().hasAll(['termin', 'saat', 'sure', 'aciklama', 'zaman'])
        && request.resource.data.termin is string && (request.resource.data.termin == '' || request.resource.data.termin.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        && request.resource.data.saat is string && (request.resource.data.saat == '' || request.resource.data.saat.matches('([01][0-9]|2[0-3]):(00|15|30|45)'))
        && request.resource.data.sure in ['', '30 dk', '1 saat', '2 saat', '4 saat', '8 saat', '2 gün', '3 gün']
        && metin(request.resource.data.aciklama, 500)
        && request.resource.data.zaman == request.time;
    }
    match /oryantasyonYetki/{t} {
      allow get: if ik() || (oryYetkiAnahtari(t) && resource.data.durum == 'acik');
      allow list, delete: if ik();
      allow create, update: if ik() && oryYetkiAnahtari(t) && oryYetkiIk();
      match /oryGirdi/{m} {
        allow get, list: if ik() || (oryYetkiAnahtari(t) && oryYetkiKaydi(t).durum == 'acik');
        allow create, update: if oryGirdiGecerli() && (
          (ik() && (!('ik' in request.resource.data) || request.resource.data.ik == true))
          || (oryYetkiAnahtari(t) && !('ik' in request.resource.data) && oryGirdiSorumlu(t, m)));
        allow delete: if ik();
      }
    }
    // İK: tüm bağlantıların satır girdileri tek sorguyla (koleksiyon grubu "oryGirdi")
    match /{yol=**}/oryGirdi/{m} {
      allow read: if ik();
    }
    // E-POSTA KUYRUĞU: İK yazar (durum "bekliyor"); gönderimi GitHub Actions görevi yapar (ise-alim-sureci deposu,
    // scripts/eposta-kuyrugu.js, yönetici hesabıyla — kural dışı). Yalnız şirket alan adına (@inciroglu.com.tr) gönderilir.
    // İK bekleyen e-postayı iptal edebilir; gönderilmiş kayıt değiştirilemez.
    // Personel talebi e-postası (16.11.2026): İK dışında talep zincirindeki kişi de yazabilir, ama YALNIZ aynı toplu
    // yazmada talebin durumunu geçerli biçimde değiştirirken (talep.sonBildirim bu kayda döner ve daha önce dönmüyordu)
    // ve YALNIZ sıradaki onaylayıcının talepte kayıtlı (talepAyar/zincir ile birebir) adresine. Her geçiş en fazla bir e-posta.
    // İÇERİK İSTEMCİDEN GELMEZ: konu ve gövde boş yazılır; gönderici (scripts/eposta-kuyrugu.js) talep kaydından kendi
    // şablonuyla üretir (sablon: 'direktor' | 'ik'). Böylece kimse İK adresinden serbest içerikli e-posta gönderemez.
    function ptEposta(id, y) {
      let tYol = yol('personelTalepFormlari', y.ilgili);
      let t = getAfter(tYol).data;
      return gecerli()
        && y.kaynak == 'personel-talebi'
        && y.ilgili.matches('[A-Za-z0-9]{1,40}')
        && y.konu == '' && y.html == '' && y.olusturan == hesap().ad
        && y.sablon in ['direktor', 'ik'] && y.sablon == t.durum
        && t.sonBildirim == id
        && (!exists(tYol) || get(tYol).data.sonBildirim != id)
        && y.kime == t.zincir[y.sablon].eposta;
    }
    // Savunma talebi e-postası (25.11.2026): ptEposta ile aynı mantık. İÇERİK İSTEMCİDEN GELMEZ (konu/gövde boş; gönderici
    // scripts/savunma-eposta.js ile talep kaydından üretir, ekleri savunmalar/{id}/ekler'den alır). Her geçiş en fazla bir e-posta:
    // 'onay' (İK onayı → talebi açan müdür, talepte kayıtlı mudurEposta) · 'kapanis' (müdür taranmış belgeyi yükledi ya da imtina
    // işaretledi → çalışanın direktörü, talepte kayıtlı direktorEposta).
    function svEposta(id, y) {
      let sYol = yol('savunmalar', y.ilgili);
      let s = getAfter(sYol).data;
      return gecerli()
        && y.kaynak == 'savunma'
        && y.ilgili.matches('[A-Za-z0-9]{20}')
        && y.konu == '' && y.html == '' && y.olusturan == hesap().ad
        && y.sablon in ['onay', 'kapanis']
        && s.sonBildirim == id
        && exists(sYol) && get(sYol).data.sonBildirim != id
        && ((y.sablon == 'onay' && s.durum == 'onaylandi' && svIk() && y.kime == s.mudurEposta)
          || (y.sablon == 'kapanis' && s.durum == 'kapandi' && (svIk() || s.mudur.hid == benimHid()) && y.kime == s.direktorEposta));
    }
    match /epostaKuyrugu/{id} {
      allow read: if ik();
      allow create: if request.resource.data.keys().hasOnly(['kime', 'kimeAd', 'konu', 'html', 'kaynak', 'ilgili', 'durum', 'olusturma', 'olusturan', 'sablon'])
        && (!('sablon' in request.resource.data) || request.resource.data.sablon in ['direktor', 'ik', 'onay', 'kapanis'])
        && request.resource.data.kime is string && request.resource.data.kime.matches('[a-z0-9._%+-]+@inciroglu[.]com[.]tr')
        && metin(request.resource.data.kimeAd, 120) && !request.resource.data.kimeAd.matches('.*[@,;"].*')
        && metin(request.resource.data.konu, 200)
        && request.resource.data.html is string && request.resource.data.html.size() <= 60000
        && metin(request.resource.data.kaynak, 40) && metin(request.resource.data.ilgili, 120) && metin(request.resource.data.olusturan, 120)
        && request.resource.data.durum == 'bekliyor'
        && request.resource.data.olusturma == request.time
        && (ik() || ptEposta(id, request.resource.data) || svEposta(id, request.resource.data));
      allow update: if ik() && resource.data.durum == 'bekliyor' && request.resource.data.durum == 'iptal'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['durum']);
      allow delete: if false;
    }
    // Rol adı hesaptaki gerçek role bağlıdır (oryantasyon.html ROL_ADI ile birebir). İK kopya oluşturmaz (sayılara karışmasın).
    function oryRolKodu() {
      return { 'Direktör': 'direktor', 'Satış Müdürü': 'satis_mudur', 'Servis Müdürü': 'servis_mudur',
               'İdari Müdür': 'idari_mudur', 'Departman Müdürü': 'mudur' };
    }
    function oryRolGecerli(r) {
      return r is string && r in oryRolKodu() && hesap().roller.hasAny([oryRolKodu()[r]]) && !hesap().roller.hasAny(['ik']);
    }
    // Hangi rol hangi unvanın formunu düzenleyebilir (oryantasyon.html ROL_UNVAN ile birebir, 13.11.2026):
    // satış müdürü → satış danışmanı + satış müdürü; servis müdürü → servis danışmanı + servis müdürü;
    // direktör, idari müdür, departman müdürü → hepsi
    function oryUnvanIzinli(kod) {
      let r = hesap().roller;
      return r.hasAny(['direktor', 'idari_mudur', 'mudur'])
        || (r.hasAny(['satis_mudur']) && kod in ['satis-danismani', 'satis-muduru'])
        || (r.hasAny(['servis_mudur']) && kod in ['servis-danismani', 'servis-muduru']);
    }
    function oryOzetAlanlari() {
      return ['degisen', 'eklenen', 'silinen', 'sira', 'bolumDegisen', 'bolumEklenen', 'bolumSilinen', 'bolumMaddeSilinen',
              'alanDegisen', 'alanEklenen', 'alanSilinen', 'toplam'];
    }
    function oryDuzenlemeGecerli(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['kod', 'hid', 'ad', 'rol', 'durum', 'form', 'taban', 'tabanSurum', 'ozet', 'olusturma', 'guncelleme'])
        && d.keys().hasAll(['kod', 'hid', 'ad', 'rol', 'durum', 'form', 'taban', 'tabanSurum', 'ozet', 'olusturma', 'guncelleme'])
        && unvanKodu(d.kod)
        && d.hid == benimHid()
        && id == d.kod + '__' + d.hid
        && d.ad == hesap().ad
        && oryRolGecerli(d.rol)
        && oryUnvanIzinli(d.kod)
        && d.durum in ['duzenlendi', 'onaylandi']
        && oryFormSekli(d.form) && oryFormSekli(d.taban)
        && d.ozet is map && d.ozet.keys().hasOnly(oryOzetAlanlari())
        && d.tabanSurum is int && d.tabanSurum >= 1
        && d.taban == get(orySurumYolu(d.kod, d.tabanSurum)).data.form
        && ((d.durum == 'onaylandi') == (d.form == d.taban))
        && d.guncelleme == request.time
        && (resource == null ? d.olusturma == request.time : d.olusturma == resource.data.olusturma);
    }
    match /oryantasyonDuzenlemeleri/{id} {
      allow get, list: if ik() || (gecerli() && resource.data.hid == benimHid());
      allow create, update: if yonetim() && oryDuzenlemeGecerli(id);
      allow delete: if ik() || (gecerli() && resource.data.hid == benimHid());
    }

    // ====================================================== PERSONEL TALEPLERİ + AÇIK POZİSYONLAR (16.11.2026)
    // Sayfa: personel-talep.html · seçenek listeleri ve alan adları: ortak/personel-talep.js (BİREBİR aynı olmalı).
    // Akış: talep eden yönetici → departman direktörü → İK Direktörü → CEO. Direktör ve İK Direktörü kendi hesaplarıyla
    // karar verir. CEO sisteme girmez: kararını İK (İK rolü ya da talebin İK Direktörü) işaretler.
    // KİŞİ KİMLİĞİ: bu modülde hesap kimliği (hid = TC özeti) HİÇBİR belgeye yazılmaz (TC'ye geri çevrilebilir). Her yönetim
    // hesabına İK bir kez rastgele "talep kimliği" (pid, 128 bit) verir: talepKimlik/{hid} = {pid}. Kişi yalnız kendi
    // kaydını okur. Talep, zincir, onay ve görünürlük (pidler) bu kimlikle tutulur.
    // Talebi yalnız İK ve "pidler" dizisindekiler (talep eden, direktör, İK Direktörü) görür. Onay zinciri talepAyar/zincir
    // kaydıyla birebir olmalıdır (talep eden direktörü ya da e-posta adresini değiştiremez). Onay kayıtlarında ad hesaptan,
    // zaman sunucudan doğrulanır. Geçmiş yalnız sonuna ekleme yapılarak büyür. Silme yok.
    match /talepKimlik/{h} {
      allow get: if ik() || (gecerli() && benimHid() == h);
      allow list: if ik();
      allow create: if ik()
        && request.resource.data.keys().hasOnly(['pid', 'olusturma'])
        && request.resource.data.pid is string && request.resource.data.pid.matches('p[0-9a-f]{32}')
        && request.resource.data.olusturma == request.time;
      allow update, delete: if false;
    }
    function ptBen() { return get(yol('talepKimlik', benimHid())).data.pid; }
    function ptPid(v) { return v is string && v.matches('p[0-9a-f]{32}'); }
    function ptAyar() { return get(yol('talepAyar', 'zincir')).data; }
    function ptKisiGecerli(k) {
      return k is map && k.keys().hasOnly(['pid', 'ad', 'eposta']) && k.keys().hasAll(['pid', 'ad', 'eposta'])
        && (k.pid == '' || ptPid(k.pid)) && metin(k.ad, 120)
        && (k.eposta == '' || (k.eposta is string && k.eposta.matches('[a-z0-9._%+-]+@inciroglu[.]com[.]tr')));
    }
    function ptAyarGecerli(y) {
      return y.keys().hasOnly(['departmanlar', 'ikDirektor', 'ceo', 'guncelleme', 'guncelleyen'])
        && y.departmanlar is map && y.departmanlar.size() <= 150
        && ptKisiGecerli(y.ikDirektor) && ptPid(y.ikDirektor.pid)
        && y.ceo is map && y.ceo.keys().hasOnly(['ad']) && metin(y.ceo.ad, 120) && y.ceo.ad.size() > 0
        && y.guncelleme == request.time && metin(y.guncelleyen, 120);
    }
    match /talepAyar/{b} {
      allow get: if yonetim();
      allow create, update: if ik() && b == 'zincir' && ptAyarGecerli(request.resource.data);
      allow delete: if false;
    }
    function ptTarih(v) { return v is string && v.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'); }
    function ptTutar(v) { return v is number && v >= 0 && v <= 100000000; }
    function ptListe(v, liste) { return v is list && v.size() >= 1 && v.size() <= liste.size() && v.hasOnly(liste); }
    function ptFormAlanlari() {
      return ['tarih', 'pozisyon', 'deneyim', 'mezuniyet', 'cinsiyet', 'beklentiler', 'sertifikalar', 'adayAd', 'adayYok',
              'gorevTanimi', 'nedenler', 'yerineKim', 'yerineCikis', 'aciklama', 'icAday', 'devam', 'devamAciklama', 'riskler',
              'riskAciklama', 'ucretYonetici', 'butceYillik', 'butceKullanilan', 'marka', 'markaDayanak'];
    }
    // Kullanıcı kararı: formdaki HER bilgi eksiksiz girilir (marka dayanağı yalnız "Zorunluluk yok" seçilince boş kalabilir)
    function ptFormGecerli(f) {
      return f is map && f.keys().hasOnly(ptFormAlanlari()) && f.keys().hasAll(ptFormAlanlari())
        && ptTarih(f.tarih)
        && metin(f.pozisyon, 120) && f.pozisyon.size() > 0
        && metin(f.deneyim, 300) && f.deneyim.size() > 0
        && metin(f.mezuniyet, 200) && f.mezuniyet.size() > 0
        && f.cinsiyet in ['Fark etmez', 'Kadın', 'Erkek']
        && metin(f.beklentiler, 2000) && f.beklentiler.size() > 0
        && metin(f.sertifikalar, 500) && f.sertifikalar.size() > 0
        && f.adayYok is bool && metin(f.adayAd, 120) && (f.adayYok || f.adayAd.size() > 0)
        && metin(f.gorevTanimi, 4000) && f.gorevTanimi.size() >= 20
        && ptListe(f.nedenler, ['Ek kadro', 'İş hacmi artışı', 'Yeni kadro açılması', 'Personel yedekleme', 'Organizasyonel revizyon', 'Yerine alım'])
        && metin(f.yerineKim, 300) && (f.yerineCikis == '' || ptTarih(f.yerineCikis))
        && (!('Yerine alım' in f.nedenler) || (f.yerineKim.size() > 0 && f.yerineCikis.size() > 0))
        && metin(f.aciklama, 4000) && f.aciklama.size() >= 20
        && f.icAday in ['İç aday değerlendirilebilir', 'İç aday talebi yoktur', 'Geliştirilebilir iç aday değerlendirilebilir']
        && f.devam in ['Sürdürülebilir', 'Kısa vadede sürdürülebilir', 'Sürdürülemez']
        && metin(f.devamAciklama, 1000) && (f.devam != 'Sürdürülemez' || f.devamAciklama.size() > 0)
        && ptListe(f.riskler, ['İş kaybı', 'Müşteri memnuniyeti', 'Kalite etkisi'])
        && metin(f.riskAciklama, 2000) && f.riskAciklama.size() > 0
        && ptTutar(f.ucretYonetici) && ptTutar(f.butceYillik) && ptTutar(f.butceKullanilan)
        && f.marka in ['Zorunlu kadro', 'Tavsiye edilen kadro', 'Zorunluluk yok']
        && metin(f.markaDayanak, 1000) && (f.marka == 'Zorunluluk yok' || f.markaDayanak.size() > 0);
    }
    // Zincir ve görünürlük: departman, direktör, İK Direktörü ve CEO ayardaki kayıtla birebir; pidler bunlardan türetilir
    function ptZincirGecerli(y) {
      let a = ptAyar();
      return y.depKey is string && y.depKey in a.departmanlar
        && y.departman == a.departmanlar[y.depKey].ad
        && y.bolum == a.departmanlar[y.depKey].bolum
        && y.zincir is map && y.zincir.keys().hasOnly(['direktor', 'ik', 'ceo'])
        && y.zincir.direktor == a.departmanlar[y.depKey].direktor
        && y.zincir.ik == a.ikDirektor
        && y.zincir.ceo == a.ceo
        && ptKisiGecerli(y.zincir.direktor) && ptPid(y.zincir.direktor.pid)
        && y.pidler == [y.talepEden.pid, y.zincir.direktor.pid, y.zincir.ik.pid];
    }
    function ptOnayKaydi(k, adina) {
      return k is map && k.keys().hasOnly(['karar', 'not', 'ad', 'pid', 'zaman', 'adina'])
        && k.keys().hasAll(['karar', 'not', 'ad', 'pid', 'zaman', 'adina'])
        && metin(k.not, 1000) && k.pid == ptBen() && k.ad == hesap().ad
        && k.zaman == request.time && k.adina == adina;
    }
    // Başlangıç: direktör onayına gider; talebi departmanın direktörü açtıysa direktör imzası atılmış olarak İK'ya gider
    function ptBaslangic(y) {
      return y.onaylar is map && (
        (y.durum == 'direktor' && y.onaylar.size() == 0)
        || (y.durum == 'ik' && y.zincir.direktor.pid == ptBen() && y.onaylar.keys().hasOnly(['direktor'])
            && ptOnayKaydi(y.onaylar.direktor, false) && y.onaylar.direktor.karar == 'onay'));
    }
    function ptOlayGecerli(e) {
      return e is map && e.keys().hasOnly(['zaman', 'kim', 'olay', 'not']) && e.zaman is int
        && e.kim == hesap().ad && metin(e.olay, 200) && e.olay.size() > 0 && metin(e.not, 1000);
    }
    function ptGecmisEk(o, s) {
      return s.gecmis is list && s.gecmis.size() == o.gecmis.size() + 1 && s.gecmis.size() <= 300
        && s.gecmis == o.gecmis.concat([s.gecmis[o.gecmis.size()]])
        && ptOlayGecerli(s.gecmis[o.gecmis.size()]);
    }
    function ptAlanlar() {
      return ['no', 'durum', 'depKey', 'departman', 'bolum', 'form', 'ikDeg', 'talepEden', 'zincir', 'pidler', 'onaylar',
              'gecmis', 'surum', 'olusturma', 'guncelleme', 'sonBildirim'];
    }
    function ptYeniTalep(y) {
      return y.keys().hasOnly(ptAlanlar()) && y.keys().hasAll(ptAlanlar())
        && metin(y.no, 20) && y.no.size() > 0
        && y.talepEden is map && y.talepEden.keys().hasOnly(['pid', 'ad', 'unvan'])
        && ptPid(ptBen()) && y.talepEden.pid == ptBen() && y.talepEden.ad == hesap().ad && metin(y.talepEden.unvan, 120)
        && ptFormGecerli(y.form) && ptZincirGecerli(y) && ptBaslangic(y)
        && y.ikDeg is map && y.ikDeg.size() == 0 && y.surum == 1
        && y.olusturma == request.time && y.guncelleme == request.time
        && y.gecmis is list && y.gecmis.size() == 1 && ptOlayGecerli(y.gecmis[0])
        && y.sonBildirim is string && y.sonBildirim.size() <= 40;
    }
    function ptIkYetkili(o) { return ik() || o.zincir.ik.pid == ptBen(); }
    function ptDegisen(o, s, izinli) { return s.diff(o).affectedKeys().hasOnly(izinli); }
    function ptGecisler() {
      return {
        'direktor': { 'onay': 'ik', 'revize': 'revize', 'red': 'reddedildi' },
        'ik': { 'onay': 'ceo', 'revize': 'revize', 'red': 'reddedildi' },
        'ceo': { 'onay': 'onaylandi', 'revize': 'revize', 'erteleme': 'ertelendi', 'red': 'reddedildi' }
      };
    }
    // Karar: yalnız o aşamanın kişisi, yalnız kendi onay kaydını yazar; ret / revize / erteleme gerekçesiz olmaz
    function ptKararOnay(o, s, asama, kararlar, adina) {
      return s.onaylar is map && s.onaylar.diff(o.onaylar).affectedKeys().hasOnly([asama])
        && ptOnayKaydi(s.onaylar[asama], adina)
        && s.onaylar[asama].karar in kararlar
        && (s.onaylar[asama].karar == 'onay' || s.onaylar[asama].not.size() > 0)
        && s.durum == ptGecisler()[asama][s.onaylar[asama].karar];
    }
    function ptKarar(o, s) {
      return (o.durum == 'direktor' && o.zincir.direktor.pid == ptBen()
              && ptDegisen(o, s, ['durum', 'onaylar', 'gecmis', 'guncelleme', 'sonBildirim'])
              && ptKararOnay(o, s, 'direktor', ['onay', 'revize', 'red'], false))
        || (o.durum == 'ik' && o.zincir.ik.pid == ptBen()
              && ptDegisen(o, s, ['durum', 'onaylar', 'ikDeg', 'gecmis', 'guncelleme'])
              && ptKararOnay(o, s, 'ik', ['onay', 'revize', 'red'], false)
              && ((s.onaylar.ik.karar != 'onay' && s.ikDeg == o.ikDeg)
                  || (s.onaylar.ik.karar == 'onay' && s.ikDeg.keys().hasOnly(['ucretIk', 'kadroUygun'])
                      && s.ikDeg.keys().hasAll(['ucretIk', 'kadroUygun']) && ptTutar(s.ikDeg.ucretIk) && s.ikDeg.kadroUygun is bool)))
        || (o.durum == 'ceo' && ptIkYetkili(o)
              && ptDegisen(o, s, ['durum', 'onaylar', 'gecmis', 'guncelleme'])
              && ptKararOnay(o, s, 'ceo', ['onay', 'revize', 'erteleme', 'red'], true));
    }
    // Revize istenen talebi talep eden düzeltip yeniden gönderir: zincir güncel ayardan, onaylar baştan
    function ptYenidenGonder(o, s) {
      return o.durum == 'revize' && o.talepEden.pid == ptBen()
        && ptDegisen(o, s, ['durum', 'depKey', 'departman', 'bolum', 'form', 'ikDeg', 'zincir', 'pidler', 'onaylar', 'gecmis',
                            'surum', 'guncelleme', 'sonBildirim'])
        && ptFormGecerli(s.form) && ptZincirGecerli(s) && ptBaslangic(s)
        && s.ikDeg is map && s.ikDeg.size() == 0 && s.surum == o.surum + 1
        && s.sonBildirim is string && s.sonBildirim.size() <= 40;
    }
    function ptIptal(o, s) {
      return s.durum == 'iptal' && ptDegisen(o, s, ['durum', 'gecmis', 'guncelleme'])
        && s.gecmis[o.gecmis.size()].not.size() > 0
        && ((o.talepEden.pid == ptBen() && o.durum in ['direktor', 'revize'])
            || (ptIkYetkili(o) && o.durum in ['direktor', 'ik', 'ceo', 'revize', 'ertelendi']));
    }
    function ptCeoyaGeriAl(o, s) {
      return ptIkYetkili(o) && o.durum == 'ertelendi' && s.durum == 'ceo'
        && ptDegisen(o, s, ['durum', 'onaylar', 'gecmis', 'guncelleme'])
        && s.onaylar.diff(o.onaylar).affectedKeys().hasOnly(['ceo']) && !('ceo' in s.onaylar);
    }
    // Zincir yenileme (İK): yalnız henüz imzalanmamış aşamalar değişebilir (imza atanın adı ve görünürlüğü korunur)
    function ptZincirYenile(o, s) {
      return ik() && o.durum in ['direktor', 'ik', 'ceo']
        && ptDegisen(o, s, ['zincir', 'pidler', 'gecmis', 'guncelleme'])
        && ptZincirGecerli(s)
        && (o.durum == 'direktor' || s.zincir.direktor == o.zincir.direktor)
        && (o.durum != 'ceo' || s.zincir.ik == o.zincir.ik);
    }
    function ptGuncelleme(o, s) {
      return s.keys().hasOnly(ptAlanlar()) && s.keys().hasAll(ptAlanlar())
        && s.guncelleme == request.time && ptGecmisEk(o, s)
        && (ptKarar(o, s) || ptYenidenGonder(o, s) || ptIptal(o, s) || ptCeoyaGeriAl(o, s) || ptZincirYenile(o, s));
    }
    match /personelTalepFormlari/{id} {
      allow get, list: if ik() || (gecerli() && ptBen() in resource.data.pidler);
      allow create: if yonetim() && ptYeniTalep(request.resource.data);
      allow update: if gecerli() && ptGuncelleme(resource.data, request.resource.data);
      allow delete: if false;
    }
    // Açık pozisyon: CEO onayı işaretlendiği işlemde talepten birebir açılır (ya da İK talepsiz ekler); durumunu İK yönetir.
    function apAlanlar() {
      return ['talepId', 'no', 'pozisyon', 'departman', 'bolum', 'depKey', 'durum', 'kaynak', 'pidler', 'ikPid', 'talepEdenAd',
              'direktorAd', 'kanallar', 'ikNot', 'alinanKisi', 'baslama', 'acilis', 'guncelleme', 'kapanis', 'gecmis'];
    }
    function apGecerli(y) {
      return y.keys().hasOnly(apAlanlar())
        && metin(y.talepId, 40) && metin(y.no, 20) && metin(y.pozisyon, 120) && y.pozisyon.size() > 0
        && metin(y.departman, 60) && metin(y.bolum, 20) && metin(y.depKey, 120)
        && y.durum in ['acik', 'ilanda', 'gorusme', 'teklif', 'dolduruldu', 'iptal']
        && y.kaynak in ['talep', 'elle'] && y.pidler is list && y.pidler.size() <= 3 && (y.ikPid == '' || ptPid(y.ikPid))
        && metin(y.talepEdenAd, 120) && metin(y.direktorAd, 120)
        && y.kanallar is list && y.kanallar.hasOnly(['Kariyer.net', 'LinkedIn', 'Şirket içi duyuru', 'Referans', 'Distribütör / marka portalı', 'Diğer'])
        && metin(y.ikNot, 2000) && metin(y.alinanKisi, 120) && (y.baslama == '' || ptTarih(y.baslama))
        && y.acilis is timestamp && y.guncelleme == request.time
        && (!('kapanis' in y) || y.kapanis is timestamp)
        && y.gecmis is list && y.gecmis.size() >= 1 && y.gecmis.size() <= 300;
    }
    function apTalepten(id) {
      let o = get(yol('personelTalepFormlari', id)).data;
      let t = getAfter(yol('personelTalepFormlari', id)).data;
      let y = request.resource.data;
      return o.durum == 'ceo' && t.durum == 'onaylandi' && ptIkYetkili(o)
        && y.talepId == id && y.no == t.no && y.pozisyon == t.form.pozisyon && y.departman == t.departman
        && y.bolum == t.bolum && y.depKey == t.depKey && y.durum == 'acik'
        && y.pidler == t.pidler && y.ikPid == t.zincir.ik.pid
        && y.talepEdenAd == t.talepEden.ad && y.direktorAd == t.zincir.direktor.ad
        && y.kanallar.size() == 0 && y.ikNot == '' && y.alinanKisi == '' && y.baslama == '' && !('kapanis' in y)
        && y.acilis == request.time && y.gecmis.size() == 1 && ptOlayGecerli(y.gecmis[0]);
    }
    match /acikPozisyonlar/{id} {
      allow get, list: if ik() || (gecerli() && ptBen() in resource.data.pidler);
      allow create: if gecerli() && apGecerli(request.resource.data)
        && ((request.resource.data.kaynak == 'elle' && ik() && request.resource.data.talepId == ''
             && request.resource.data.pidler.size() == 0 && request.resource.data.ikPid == ''
             && request.resource.data.acilis == request.time)
            || (request.resource.data.kaynak == 'talep' && apTalepten(id)));
      allow update: if gecerli() && apGecerli(request.resource.data)
        && (ik() || resource.data.ikPid == ptBen())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['durum', 'kanallar', 'ikNot', 'alinanKisi', 'baslama',
                                                                              'guncelleme', 'kapanis', 'gecmis'])
        && (request.resource.data.gecmis == resource.data.gecmis || ptGecmisEk(resource.data, request.resource.data));
      allow delete: if false;
    }

    // ====================================================== AJAN OFİSİ (14.11.2026) — YALNIZ OFİS SAHİBİ
    // Sahip: kurulum koduyla açılmış İK hesabı. İlk açılışta ajanOfisi/sahip {hid} BİR KEZ oluşturulur;
    // sonra değiştirilemez ve silinemez. Diğer tüm ofis verisi (ayar, Claude/ElevenLabs anahtarları, kadro,
    // işler, notlar, harcama, zamanlama) yalnız bu hesabın GÜNCEL oturumuna açıktır: İK ekibi, direktör,
    // müdürler dahil başka hiç kimse okuyamaz, yazamaz. (Zamanlayıcı yönetici yetkisiyle çalışır, kurala tabi değildir.)
    function ofisSahibi() {
      return gecerli() && exists(yol('ajanOfisi', 'sahip')) && get(yol('ajanOfisi', 'sahip')).data.hid == benimHid();
    }
    function ofisSahibiOlabilir() { return kurucuHesap(); }
    match /ajanOfisi/sahip {
      allow get: if ofisSahibi();
      allow create: if ofisSahibiOlabilir()
        && request.resource.data.keys().hasOnly(['hid', 'olusturma'])
        && request.resource.data.hid == benimHid()
        && request.resource.data.olusturma == request.time;
    }
    match /ajanOfisi/{belge} {
      allow read, write: if belge != 'sahip' && ofisSahibi();
    }
    // Alt koleksiyonlar (ajanOfisi/ofis/isler/…). {kol} zorunlu: rules_version 2'de {alt=**} sıfır parçayla da
    // eşleştiği için ajanOfisi/sahip belgesinin kendisi bu kurala GİRMEMELİ (aksi halde sahip kaydı değiştirilebilirdi).
    match /ajanOfisi/{belge}/{kol}/{alt=**} {
      allow read, write: if belge != 'sahip' && ofisSahibi();
    }

    // ====================================================== MÜDÜR PRİM SİSTEMLERİ (19.11.2026) — YALNIZ ERİŞİM LİSTESİ
    // Sayfa: prim.html · Excel okuyucu: ortak/prim-sistemleri.js. Prim verisi bu depoda YOKTUR: İK'nın Excel'i tarayıcıda
    // okunur ve primSistemleri/veri belgesine JSON metni olarak yazılır.
    // KİŞİ BAZLI: rol yetmez. Yalnız primAyar/erisim.hidler listesindeki GEÇERLİ hesaplar okur ve günceller; İK ekibi ve
    // direktörler dahil listede olmayan hiç kimse erişemez. Listeyi YALNIZ kurulum İK hesabı (Ajan Ofisi sahibi) yazar ve
    // kendini listeden çıkaramaz. Liste ve veri silinemez. Listedeki hesapların kendisi de korunur (HESAP ALTYAPISI →
    // primKorumasi: başka bir İK kullanıcısı bu hesapları devralamaz). primListe() orada tanımlıdır.
    function primYetkili() { return gecerli() && exists(yol('primAyar', 'erisim')) && benimHid() in primListe(); }
    function primErisimGecerli(y) {
      return y.keys().hasOnly(['hidler', 'guncelleme', 'guncelleyen']) && y.keys().hasAll(['hidler', 'guncelleme', 'guncelleyen'])
        && y.hidler is list && y.hidler.size() >= 1 && y.hidler.size() <= 10
        && benimHid() in y.hidler
        && y.guncelleme == request.time && y.guncelleyen == hesap().ad;
    }
    match /primAyar/{b} {
      allow get: if b == 'erisim' && (primYetkili() || kurucuHesap());
      allow create, update: if b == 'erisim' && kurucuHesap() && primErisimGecerli(request.resource.data);
      allow list, delete: if false;
    }
    function primVeriGecerli(y) {
      return y.keys().hasOnly(['json', 'dosya', 'aktaran', 'aktarim', 'surum']) && y.keys().hasAll(['json', 'dosya', 'aktaran', 'aktarim', 'surum'])
        && y.json is string && y.json.size() > 0 && y.json.size() <= 600000
        && metin(y.dosya, 200) && y.aktaran == hesap().ad && y.aktarim == request.time && y.surum is int;
    }
    match /primSistemleri/{b} {
      allow get: if b == 'veri' && primYetkili();
      allow create, update: if b == 'veri' && primYetkili() && primVeriGecerli(request.resource.data);
      allow list, delete: if false;
    }

    // ====================================================== ORGANİZASYON ŞEMASI (21.11.2026)
    // Sayfa: org-sema.html · PowerPoint okuyucu: ortak/pptx-gorunum.js. Şema (isimler) bu depoda YOKTUR: İK'nın PowerPoint
    // dosyası (.pptx) tarayıcıda açılır ve OLDUĞU GİBİ (base64 metin) orgSemasi/guncel belgesine yazılır; sayfalar her açılışta
    // bu dosyadan çizilir. Tüm yönetim rolleri okur; yalnız İK yükler (yenisi eskisinin yerine geçer). Silinemez, listelenemez.
    function orgSemaGecerli(y) {
      return y.keys().hasOnly(['dosya', 'ad', 'boyut', 'yukleyen', 'yukleme']) && y.keys().hasAll(['dosya', 'ad', 'boyut', 'yukleyen', 'yukleme'])
        && y.dosya is string && y.dosya.size() > 0 && y.dosya.size() <= 1000000
        && metin(y.ad, 200) && y.ad.size() > 0
        && y.boyut is int && y.boyut > 0 && y.boyut <= 750000
        && y.yukleyen == hesap().ad && y.yukleme == request.time;
    }
    match /orgSemasi/{b} {
      allow get: if b == 'guncel' && yonetim();
      allow create, update: if b == 'guncel' && ik() && orgSemaGecerli(request.resource.data);
      allow list, delete: if false;
    }

    // ====================================================== GÖRÜŞME DETAYLARI (24.11.2026) — KİŞİ BAZLI, TEK DÜZENLEYİCİ
    // Sayfa: gorusme.html. Aday görüşme kayıtları (ad soyad, telefon, e-posta, pozisyon, departman, iletişim şekli, tarih, notlar, sonuç, CV):
    // KİŞİSEL VERİDİR, bu depoda YOKTUR. GÖRENLER: yalnız gorusmeAyar/erisim.hidler listesindeki GEÇERLİ hesaplar (rol yetmez;
    // İK ekibi ve direktörler dahil listede olmayan hiç kimse okuyamaz). EKLEYEN / DÜZENLEYEN / SİLEN: YALNIZ kurulum İK hesabı
    // (kurucuHesap); listedeki diğer kişiler yalnız okur. Listeyi yalnız kurucu yazar ve kendini çıkaramaz; liste silinemez.
    // Listedeki hesaplar HESAP ALTYAPISI → gorusmeKorumasi ile korunur (gorusmeListe() orada tanımlıdır).
    function gorusmeYetkili() { return gecerli() && exists(yol('gorusmeAyar', 'erisim')) && benimHid() in gorusmeListe(); }
    function gorusmeErisimGecerli(y) {
      return y.keys().hasOnly(['hidler', 'guncelleme', 'guncelleyen']) && y.keys().hasAll(['hidler', 'guncelleme', 'guncelleyen'])
        && y.hidler is list && y.hidler.size() >= 1 && y.hidler.size() <= 10
        && benimHid() in y.hidler
        && y.guncelleme == request.time && y.guncelleyen == hesap().ad;
    }
    match /gorusmeAyar/{b} {
      allow get: if b == 'erisim' && (gorusmeYetkili() || kurucuHesap());
      allow create, update: if b == 'erisim' && kurucuHesap() && gorusmeErisimGecerli(request.resource.data);
      allow list, delete: if false;
    }
    function gorusmeAlanlari() { return ['ad', 'telefon', 'eposta', 'pozisyon', 'iletisim', 'tarih', 'notlar', 'sonuc', 'olusturma', 'guncelleme', 'guncelleyen']; }
    // 24.11.2026 ek alanlar: departman ve cv (isteğe bağlı: bu alanlardan önce açılmış kayıtlarda bulunmazlar).
    // cv yalnız dosya bilgisidir; dosyanın kendisi gorusmeler/{id}/cv/{yuva}_{n} parçalarındadır (aşağıda). anahtar = yuva ("a" / "b").
    function gorusmeEkAlanlar() { return ['departman', 'cv']; }
    function gorusmeCvTurleri() {
      return ['application/pdf', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
              'image/jpeg', 'image/png'];
    }
    function gorusmeCvGecerli(c) {
      return c == null || (c is map
        && c.keys().hasOnly(['ad', 'tip', 'boyut', 'parca', 'anahtar']) && c.keys().hasAll(['ad', 'tip', 'boyut', 'parca', 'anahtar'])
        && metin(c.ad, 200) && c.ad.matches('(?i).+[.](pdf|docx?|jpe?g|png)') && c.tip in gorusmeCvTurleri()
        && c.boyut is int && c.boyut > 0 && c.boyut <= 5242880
        && c.parca is int && c.parca >= 1 && c.parca <= 8
        && c.anahtar in ['a', 'b']);
    }
    function gorusmeKaydiGecerli(y) {
      return y.keys().hasOnly(gorusmeAlanlari().concat(gorusmeEkAlanlar())) && y.keys().hasAll(gorusmeAlanlari())
        && metin(y.ad, 100) && y.ad.size() >= 2
        && metin(y.telefon, 30) && metin(y.eposta, 120)
        && metin(y.pozisyon, 120) && y.pozisyon.size() > 0
        && metin(y.get('departman', ''), 80)
        && gorusmeCvGecerli(y.get('cv', null))
        && y.iletisim in ['', 'arandi', 'online', 'yuzyuze']
        && y.sonuc in ['', 'olumlu', 'beklemede', 'ikinci', 'olumsuz', 'ulasilamadi', 'vazgecti']
        && y.tarih is string && (y.tarih == '' || y.tarih.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        && y.notlar is string && y.notlar.size() <= 5000
        && y.olusturma is timestamp
        && y.guncelleme == request.time && y.guncelleyen == hesap().ad;
    }
    match /gorusmeler/{id} {
      allow get, list: if gorusmeYetkili() || kurucuHesap();
      allow create: if kurucuHesap() && otomatikKimlik(id)
        && gorusmeKaydiGecerli(request.resource.data) && request.resource.data.olusturma == request.time;
      allow update: if kurucuHesap() && gorusmeKaydiGecerli(request.resource.data)
        && request.resource.data.olusturma == resource.data.olusturma;
      allow delete: if kurucuHesap();
      // CV parçaları: dosya base64 metin olarak en çok 900.000 karakterlik parçalara bölünür (Firestore belgesi en çok 1 MiB;
      // 5 MB → en çok 8 parça). Parça adı = yuva ("a" / "b") + "_" + sıra (0–7): adlar SABİT olduğu için aday silinirken 16
      // parçanın tamamı silinir, CV veritabanında kalmaz. Görenler kayıtla aynı; yalnız kurucu yazar ve siler. Listeleme yok.
      match /cv/{p} {
        allow get: if gorusmeYetkili() || kurucuHesap();
        allow create, update: if kurucuHesap() && p.matches('[ab]_[0-7]')
          && request.resource.data.keys().hasOnly(['veri']) && request.resource.data.keys().hasAll(['veri'])
          && request.resource.data.veri is string && request.resource.data.veri.size() > 0
          && request.resource.data.veri.size() <= 900000
          && request.resource.data.veri.matches('[A-Za-z0-9+/=]+');
        allow list: if false;
        allow delete: if kurucuHesap();
      }
    }

    // ====================================================== SAVUNMA TALEPLERİ (25.11.2026)
    // Müdür (ve ekibi olan direktör) yalnız kendi ekibindeki çalışan için talep açar: ekip = savunmaKadro/{hid}.adlar (İK ekibi
    // personel listesindeki "Müdürlük" alanından üretir). Direktörler TÜM talepleri görür; Hukukçu taslaklarını (ik/taslak) ve
    // onaylanmış PDF'leri (ekler) GÖREMEZ. İK ekibi = kurucu hesap + savunmaAyar/erisim listesi (en çok 10 kişi; listeyi yalnız kurucu
    // değiştirir). Durum akışı: ik_onayinda → (İK) onaylandi | reddedildi · (müdür) iptal; onaylandi → (müdür ya da İK) kapandi.
    function svErisimGecerli(y) {
      return y.keys().hasOnly(['hidler', 'guncelleme', 'guncelleyen']) && y.keys().hasAll(['hidler', 'guncelleme', 'guncelleyen'])
        && y.hidler is list && y.hidler.size() >= 1 && y.hidler.size() <= 10
        && benimHid() in y.hidler
        && y.guncelleme == request.time && y.guncelleyen == hesap().ad;
    }
    function svEslemeGecerli(y) {
      return y.keys().hasOnly(['eposta', 'ekMudurluk', 'guncelleme', 'guncelleyen']) && y.keys().hasAll(['eposta', 'ekMudurluk', 'guncelleme', 'guncelleyen'])
        && y.eposta is map && y.eposta.size() <= 300 && y.ekMudurluk is map && y.ekMudurluk.size() <= 100
        && y.guncelleme == request.time && y.guncelleyen == hesap().ad;
    }
    match /savunmaAyar/{b} {
      allow get: if (b == 'erisim' || b == 'esleme') && svIk();
      allow create, update: if (b == 'erisim' && kurucuHesap() && svErisimGecerli(request.resource.data))
        || (b == 'esleme' && svIk() && svEslemeGecerli(request.resource.data));
      allow list, delete: if false;
    }
    function svKadroGecerli(y) {
      return y.keys().hasOnly(['ad', 'liste', 'adlar', 'guncelleme', 'guncelleyen']) && y.keys().hasAll(['ad', 'liste', 'adlar', 'guncelleme', 'guncelleyen'])
        && metin(y.ad, 120) && y.liste is list && y.liste.size() <= 200 && y.adlar is list && y.adlar.size() == y.liste.size()
        && y.guncelleme == request.time && y.guncelleyen == hesap().ad;
    }
    match /savunmaKadro/{h} {
      allow get: if (gecerli() && benimHid() == h) || svIk();
      allow list: if svIk();
      allow create, update: if svIk() && svKadroGecerli(request.resource.data);
      allow delete: if svIk();
    }
    function svTarih(v) { return v is string && v.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'); }
    function svKisi(c) {
      return c is map && c.keys().hasOnly(['ad', 'departman', 'bolum', 'unvan', 'direktor']) && c.keys().hasAll(['ad', 'departman', 'bolum', 'unvan', 'direktor'])
        && metin(c.ad, 120) && c.ad.size() > 1 && metin(c.departman, 80) && metin(c.bolum, 40) && metin(c.unvan, 120) && metin(c.direktor, 120);
    }
    function svTanik(l, i) { return l.size() <= i || metin(l[i], 80); }
    function svOlay(o) {
      return o is map && o.keys().hasOnly(['konu', 'tarih', 'saat', 'yer', 'aciklama', 'taniklar']) && o.keys().hasAll(['konu', 'tarih', 'saat', 'yer', 'aciklama', 'taniklar'])
        && o.konu in svKonular() && svTarih(o.tarih)
        && o.saat is string && (o.saat == '' || o.saat.matches('([01][0-9]|2[0-3]):[0-5][0-9]'))
        && metin(o.yer, 120) && metin(o.aciklama, 3000) && o.aciklama.size() >= 20
        && o.taniklar is list && o.taniklar.size() <= 3 && svTanik(o.taniklar, 0) && svTanik(o.taniklar, 1) && svTanik(o.taniklar, 2);
    }
    // ortak/savunma.js KONULAR ile birebir
    function svKonular() {
      return ['Devamsızlık (izinsiz işe gelmeme)', 'İşe geç gelme / erken ayrılma', 'Görev ve talimatlara aykırı davranış', 'Görevin ihmali veya özensiz yapılması',
              'İş sağlığı ve güvenliği kurallarına aykırılık', 'Müşteriye karşı uygunsuz davranış', 'İş arkadaşına karşı uygunsuz davranış',
              'Şirket varlığına zarar / kayıp', 'İşyeri kurallarına aykırılık', 'Diğer'];
    }
    // Geçmiş yalnız SONA eklenir: eski kayıtlar aynen kalır; yeni kayıt {z, ad, metin}, ad = yazan hesabın adı.
    function svGecmis(y, o) {
      return y.gecmis is list && y.gecmis.size() == o.gecmis.size() + 1 && y.gecmis.size() <= 200
        && y.gecmis[0:o.gecmis.size()] == o.gecmis
        && y.gecmis[o.gecmis.size()] is map && y.gecmis[o.gecmis.size()].keys().hasOnly(['z', 'ad', 'metin'])
        && y.gecmis[o.gecmis.size()].ad == hesap().ad && metin(y.gecmis[o.gecmis.size()].metin, 300)
        && y.gecmis[o.gecmis.size()].z is string && y.gecmis[o.gecmis.size()].z.size() <= 40;
    }
    function svDegisen(y, o, izinli) { return y.diff(o).affectedKeys().hasOnly(izinli); }
    function svEposta2(v) { return v is string && (v == '' || v.matches('[a-z0-9._%+-]+@inciroglu[.]com[.]tr')); }
    function svImza(m) { return m is map && m.keys().hasOnly(['ad', 'zaman', 'not']) && m.ad == hesap().ad && m.zaman == request.time && metin(m.get('not', ''), 1000); }
    function svOnay(y, o) {
      return svIk() && o.durum == 'ik_onayinda' && y.durum == 'onaylandi'
        && svDegisen(y, o, ['durum', 'ik', 'mudurEposta', 'direktorEposta', 'sure', 'gecmis', 'guncelleme', 'sonBildirim'])
        && svImza(y.ik) && svEposta2(y.mudurEposta) && svEposta2(y.direktorEposta)
        && y.sure is int && y.sure >= 1 && y.sure <= 7 && svGecmis(y, o);
    }
    function svRed(y, o) {
      return svIk() && o.durum == 'ik_onayinda' && y.durum == 'reddedildi'
        && svDegisen(y, o, ['durum', 'red', 'gecmis', 'guncelleme']) && svImza(y.red) && svGecmis(y, o);
    }
    function svIptal(y, o) {
      return gecerli() && o.mudur.hid == benimHid() && o.durum == 'ik_onayinda' && y.durum == 'iptal'
        && svDegisen(y, o, ['durum', 'gecmis', 'guncelleme']) && svGecmis(y, o);
    }
    function svDosya(d) {
      return d is map && d.keys().hasOnly(['ad', 'boyut', 'parca']) && d.keys().hasAll(['ad', 'boyut', 'parca'])
        && metin(d.ad, 200) && d.ad.matches('(?i).+[.]pdf') && d.boyut is int && d.boyut > 0 && d.boyut <= 6700000
        && d.parca is int && d.parca >= 1 && d.parca <= 10;
    }
    // Kapanış: imtinada dosya alanı yok; taramada dosya bilgisi + ilk ve son parça GERÇEKTEN yüklenmiş olmalı.
    function svTaramaVar(id, d) {
      return exists(/databases/$(database)/documents/savunmalar/$(id)/tarama/x_0)
        && exists(/databases/$(database)/documents/savunmalar/$(id)/tarama/$('x_' + string(d.parca - 1)));
    }
    function svKapanis(id, y, o) {
      let k = y.kapanis;
      return (svIk() || (gecerli() && o.mudur.hid == benimHid())) && o.durum == 'onaylandi' && y.durum == 'kapandi'
        && svDegisen(y, o, ['durum', 'kapanis', 'gecmis', 'guncelleme', 'sonBildirim'])
        && k is map && k.keys().hasOnly(['tur', 'ad', 'zaman', 'not', 'dosya']) && k.keys().hasAll(['tur', 'ad', 'zaman', 'not'])
        && k.tur in ['tarama', 'imtina'] && k.ad == hesap().ad && k.zaman == request.time && metin(k.not, 1000)
        && ((k.tur == 'imtina' && !('dosya' in k)) || (k.tur == 'tarama' && svDosya(k.get('dosya', null)) && svTaramaVar(id, k.dosya)))
        && svGecmis(y, o);
    }
    function svFiziki(y, o) {
      return svIk() && o.durum in ['onaylandi', 'kapandi']
        && svDegisen(y, o, ['fiziki', 'gecmis', 'guncelleme'])
        && (y.fiziki == null || (y.fiziki is map && y.fiziki.keys().hasOnly(['ad', 'zaman']) && y.fiziki.ad == hesap().ad && y.fiziki.zaman == request.time))
        && svGecmis(y, o);
    }
    function svYeni(y) {
      return yonetim()
        && y.keys().hasOnly(['no', 'durum', 'mudur', 'calisan', 'olay', 'gecmis', 'olusturma', 'guncelleme', 'sonBildirim'])
        && y.keys().hasAll(['no', 'durum', 'mudur', 'calisan', 'olay', 'gecmis', 'olusturma', 'guncelleme', 'sonBildirim'])
        && y.durum == 'ik_onayinda' && metin(y.no, 20)
        && y.mudur is map && y.mudur.keys().hasOnly(['hid', 'ad', 'unvan']) && y.mudur.hid == benimHid() && y.mudur.ad == hesap().ad && metin(y.mudur.unvan, 80)
        && svKisi(y.calisan) && exists(yol('savunmaKadro', benimHid())) && y.calisan in get(yol('savunmaKadro', benimHid())).data.liste
        && svOlay(y.olay)
        && y.gecmis is list && y.gecmis.size() == 1 && y.gecmis[0] is map && y.gecmis[0].keys().hasOnly(['z', 'ad', 'metin']) && y.gecmis[0].ad == hesap().ad
        && y.olusturma == request.time && y.guncelleme == request.time && y.sonBildirim == '';
    }
    function svOkur(s) { return svIk() || rol('direktor') || (gecerli() && s.mudur.hid == benimHid()); }
    match /savunmalar/{id} {
      allow get, list: if svOkur(resource.data);
      allow create: if otomatikKimlik(id) && svYeni(request.resource.data);
      allow update: if request.resource.data.guncelleme == request.time && request.resource.data.olusturma == resource.data.olusturma
        && (svOnay(request.resource.data, resource.data) || svRed(request.resource.data, resource.data) || svIptal(request.resource.data, resource.data)
          || svKapanis(id, request.resource.data, resource.data) || svFiziki(request.resource.data, resource.data));
      allow delete: if false;
      // Hukukçu taslakları (savunma istem yazısı, tutanak, imtina tutanağı): YALNIZ İK ekibi (direktör ve müdür göremez).
      match /ik/{b} {
        allow get: if b == 'taslak' && svIk();
        allow create, update: if b == 'taslak' && svIk()
          && request.resource.data.keys().hasOnly(['istem', 'tutanak', 'imtina', 'kaynak', 'hukukcu', 'guncelleme', 'guncelleyen'])
          && request.resource.data.kaynak in ['sablon', 'hukukcu', 'ik']
          && request.resource.data.guncelleme == request.time;
        allow list, delete: if false;
      }
      // Onaylanmış PDF'ler (e-postaya eklenir): İK yazar (YALNIZ talep İK onayındayken; onaydan sonra değişmez);
      // İK ve talebi açan müdür okur (direktör okuyamaz).
      match /ekler/{b} {
        allow get: if b in ['istem', 'tutanak'] && (svIk() || (gecerli() && get(yol('savunmalar', id)).data.mudur.hid == benimHid()));
        allow create, update: if b in ['istem', 'tutanak'] && svIk() && get(yol('savunmalar', id)).data.durum == 'ik_onayinda'
          && request.resource.data.keys().hasOnly(['veri', 'ad', 'boyut']) && request.resource.data.keys().hasAll(['veri', 'ad', 'boyut'])
          && request.resource.data.veri is string && request.resource.data.veri.size() > 0 && request.resource.data.veri.size() <= 900000
          && request.resource.data.veri.matches('[A-Za-z0-9+/=]+') && metin(request.resource.data.ad, 200) && request.resource.data.boyut is int;
        allow list, delete: if false;
      }
      // Taranmış imzalı belge (PDF, en çok 10 parça × 900.000 base64 karakter ≈ 6,7 MB): YALNIZ talep "onaylandi" iken yazılır
      // (talebi açan müdür ya da İK ekibi); kapanmış talebin belgesi değişmez. Okuyan: talebi açan müdür, direktörler ve İK ekibi.
      match /tarama/{p} {
        allow get: if svIk() || rol('direktor') || (gecerli() && get(yol('savunmalar', id)).data.mudur.hid == benimHid());
        allow create, update: if p.matches('x_[0-9]')
          && request.resource.data.keys().hasOnly(['veri']) && request.resource.data.keys().hasAll(['veri'])
          && request.resource.data.veri is string && request.resource.data.veri.size() > 0 && request.resource.data.veri.size() <= 900000
          && request.resource.data.veri.matches('[A-Za-z0-9+/=]+')
          && get(yol('savunmalar', id)).data.durum == 'onaylandi'
          && (svIk() || (gecerli() && get(yol('savunmalar', id)).data.mudur.hid == benimHid()));
        allow list: if false;
        allow delete: if svIk();
      }
    }
  }
}
